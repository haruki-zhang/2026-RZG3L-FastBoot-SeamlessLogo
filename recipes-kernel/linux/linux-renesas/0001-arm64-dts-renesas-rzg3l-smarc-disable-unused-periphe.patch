From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zixuan Zhang <zixuan.zhang.uj@renesas.com>
Date: Mon, 7 Sep 2026 10:00:00 +0900
Subject: [PATCH] arm64: dts: renesas: rzg3l-smarc: disable unused peripherals
 for fast boot

Every enabled node costs boot time twice: once when its driver probes, and
again when udev turns the resulting device into systemd units that the boot
transaction has to walk.

Collect the nodes the fast-boot product profile does not use into one
overlay and include it at the end of the board .dts, so the pruning is
visible in a single file instead of scattered through the board
description.  Only sound_card has to be edited in place - it has no label,
so an overlay cannot reach it.

The display path (vspd, du, dsi, i2c2 with the ADV7535) is deliberately
left alone, which is what lets meta-rzg3l-fast-logo stack on top of this
layer without either one having to know about the other.

Upstream-Status: Inappropriate [RZ/G3L fast-boot product profile, board specific]
---
 .../boot/dts/renesas/r9a08g046l48-smarc.dts   |  4 ++
 .../dts/renesas/rzg3l-smarc-fastboot.dtsi     | 68 +++++++++++++++++++
 2 files changed, 72 insertions(+)
 create mode 100644 arch/arm64/boot/dts/renesas/rzg3l-smarc-fastboot.dtsi

diff --git a/arch/arm64/boot/dts/renesas/r9a08g046l48-smarc.dts b/arch/arm64/boot/dts/renesas/r9a08g046l48-smarc.dts
--- a/arch/arm64/boot/dts/renesas/r9a08g046l48-smarc.dts
+++ b/arch/arm64/boot/dts/renesas/r9a08g046l48-smarc.dts
@@ -309,5 +309,6 @@ sound_card {
 		compatible = "audio-graph-card";
 		label = "HDMI-Audio";
 		dais = <&i2s2_port>;
+		status = "disabled";
 	};
 #endif
@@ -972,3 +973,6 @@ i2s2_cpu_endpoint: endpoint {
 	};
 };
 #endif
+
+/* Fast-boot peripheral pruning. Keep this the last line of the file. */
+#include "rzg3l-smarc-fastboot.dtsi"
diff --git a/arch/arm64/boot/dts/renesas/rzg3l-smarc-fastboot.dtsi b/arch/arm64/boot/dts/renesas/rzg3l-smarc-fastboot.dtsi
new file mode 100644
--- /dev/null
+++ b/arch/arm64/boot/dts/renesas/rzg3l-smarc-fastboot.dtsi
@@ -0,0 +1,68 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+/*
+ * RZ/G3L SMARC fast-boot device-tree pruning.
+ *
+ * Disables the peripherals the fast-boot profile does not use, so the kernel
+ * neither probes them nor emits udev events for them.  Restoring a function
+ * means re-enabling the node here *and* its kernel config and its userspace
+ * service - see README section V.
+ *
+ * The display path is deliberately untouched: vspd, du, dsi and i2c2 - which
+ * carries the ADV7535 HDMI bridge - all stay enabled.
+ */
+
+/* Ethernet */
+&eth0       { status = "disabled"; };
+&eth1       { status = "disabled"; };
+
+/* USB: PHYs, EHCI/OHCI, HSUSB */
+&phyrst     { status = "disabled"; };
+&usb2_phy0  { status = "disabled"; };
+&usb2_phy1  { status = "disabled"; };
+&ehci0      { status = "disabled"; };
+&ohci0      { status = "disabled"; };
+&hsusb0     { status = "disabled"; };
+&ehci1      { status = "disabled"; };
+&ohci1      { status = "disabled"; };
+
+/* PCIe: skips enumeration of an empty slot. */
+&pcie       { status = "disabled"; };
+
+/* RSPI2 */
+&spi2       { status = "disabled"; };
+
+/* CAN */
+&canfd      { status = "disabled"; };
+
+/* Camera: CRU, CSI-2, ISU and the OV5645 on i2c1 */
+&cru        { status = "disabled"; };
+&csi2       { status = "disabled"; };
+&isu2       { status = "disabled"; };
+&i2c1       { status = "disabled"; };
+
+/* Audio: SSI0/SSI2, PDM, the sound card and the DA7212 on i2c3 */
+&ssi0       { status = "disabled"; };
+&ssi2       { status = "disabled"; };
+&pdm        { status = "disabled"; };
+&snd_rzg3l  { status = "disabled"; };
+&i2c3       { status = "disabled"; };
+
+/* i2c0 carries only versa3, which clocks the audio and Ethernet blocks. */
+&i2c0       { status = "disabled"; };
+
+/* adc0. adc1 stays enabled: it is the TSU thermal-protection input. */
+&adc0       { status = "disabled"; };
+
+/* PWM and its output protection: no backlight on the HDMI path. */
+&gpt        { status = "disabled"; };
+&poegd      { status = "disabled"; };
+
+/* Extra UARTs. scif0 stays as the console. */
+&rsci2      { status = "disabled"; };
+&rsci3      { status = "disabled"; };
+
+/* RTC */
+&rtc        { status = "disabled"; };
+&vbattb     { status = "disabled"; };
+
+/* sdhi1 (microSD) stays enabled: it is the development boot path. */

