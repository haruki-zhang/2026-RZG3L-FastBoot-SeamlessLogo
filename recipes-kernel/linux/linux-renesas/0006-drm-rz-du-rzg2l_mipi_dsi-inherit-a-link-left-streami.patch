From 7ad2de0e935e54c57a3ff7818952d31873d3d664 Mon Sep 17 00:00:00 2001
From: Zixuan Zhang <zixuan.zhang.uj@renesas.com>
Date: Wed, 5 Aug 2026 11:56:43 +0900
Subject: [PATCH] drm: rz-du: rzg2l_mipi_dsi: inherit a link left streaming by
 the bootloader

With "renesas,seamless-boot-logo" on the DSI node the D-PHY is powered,
the HS clock is running and video channel 1 is transmitting before the
driver is even probed.  Three sequences would take that down.

rzg2l_mipi_dsi_probe() re-runs dphy_init() with 80Mbps timings just to be
able to read TXSETR, then dphy_exit()s, which clears EN_LDO1200 and EN_BGR
and powers the PHY off.  The PHY is already initialised for the real mode
here, so read TXSETR directly - it reports the four lanes U-Boot enabled.

rzg2l_mipi_dsi_startup() calls dphy_conf_clks(), which clk_set_rate()s the
video clock and therefore re-locks PLL7, and then re-runs the D-PHY
power-up.  rzg2l_mipi_dsi_atomic_enable() restarts the HS clock, rewrites
the VICH1 channel timings and restarts video input.  All of it reproduces
what is already programmed: U-Boot derives its DSI timings with the same
formula this driver uses, and for 1280x720@60 over four lanes at 24bpp it
arrives at the same CLSTPTSETR/LPTRNSTSETR values the driver would pick.

Finally, the put at the end of probe would runtime-suspend the device and
rzg2l_mipi_pm_runtime_suspend() would assert MIPI_DSI_ARESET_N and
PRESET_N under the live link.  Hold a PM reference for the duration of the
hand-over instead of special-casing the suspend callback, so that every
get keeps its put and the reference count stays balanced.

The hand-over reference is released - and normal behaviour restored - by
the first atomic enable or disable, by probe failure, and by remove.
---
 .../gpu/drm/renesas/rz-du/rzg2l_mipi_dsi.c    | 90 +++++++++++++++++--
 1 file changed, 84 insertions(+), 6 deletions(-)

diff --git a/drivers/gpu/drm/renesas/rz-du/rzg2l_mipi_dsi.c b/drivers/gpu/drm/renesas/rz-du/rzg2l_mipi_dsi.c
index 4815222f8644..b023411ec1d5 100644
--- a/drivers/gpu/drm/renesas/rz-du/rzg2l_mipi_dsi.c
+++ b/drivers/gpu/drm/renesas/rz-du/rzg2l_mipi_dsi.c
@@ -89,8 +89,30 @@ struct rzg2l_mipi_dsi {
 	/* DCS buffer pointers when using external memory. */
 	dma_addr_t dcs_buf_phys;
 	u8 *dcs_buf_virt;
+
+	/*
+	 * Set from the "renesas,seamless-boot-logo" DT property: the
+	 * bootloader left the D-PHY powered and the video channel streaming.
+	 * While it is set a runtime PM reference is held so that the DSI
+	 * resets are never asserted behind the running link.  Consumed by the
+	 * first atomic enable or disable, whichever comes first.
+	 */
+	bool boot_logo_handover;
 };
 
+/*
+ * Give the DSI back to runtime PM: the kernel now owns the link, so the
+ * normal enable/disable sequences apply from here on.  Idempotent.
+ */
+static void rzg2l_mipi_dsi_finish_handover(struct rzg2l_mipi_dsi *dsi)
+{
+	if (!dsi->boot_logo_handover)
+		return;
+
+	dsi->boot_logo_handover = false;
+	pm_runtime_put(dsi->dev);
+}
+
 static inline struct rzg2l_mipi_dsi *
 bridge_to_rzg2l_mipi_dsi(struct drm_bridge *bridge)
 {
@@ -438,6 +460,16 @@ static int rzg2l_mipi_dsi_startup(struct rzg2l_mipi_dsi *dsi,
 	if (ret < 0)
 		return ret;
 
+	/*
+	 * The link is already up with these exact settings.  Re-running the
+	 * sequence would clk_set_rate() the video clock - re-locking PLL7 -
+	 * and power-cycle the D-PHY LDO and BGR, both of which drop the HS
+	 * link.  Keep the PM reference taken above so the get/put pairing is
+	 * unchanged, and skip the programming.
+	 */
+	if (dsi->boot_logo_handover)
+		return 0;
+
 	ret = dsi->info->dphy_conf_clks(dsi, mode->clock, &hsfreq_millihz);
 	if (ret < 0)
 		goto err_phy;
@@ -733,6 +765,16 @@ static void rzg2l_mipi_dsi_atomic_enable(struct drm_bridge *bridge,
 	struct drm_crtc *crtc;
 	int ret;
 
+	/*
+	 * The HS clock is running, the channel timings are programmed and
+	 * video is already being transmitted.  Restarting any of that makes
+	 * the sink re-sync, so just release the hand-over.
+	 */
+	if (dsi->boot_logo_handover) {
+		rzg2l_mipi_dsi_finish_handover(dsi);
+		return;
+	}
+
 	ret = rzg2l_mipi_dsi_start_hs_clock(dsi);
 	if (ret < 0)
 		goto err_stop;
@@ -763,6 +805,13 @@ static void rzg2l_mipi_dsi_atomic_disable(struct drm_bridge *bridge,
 	rzg2l_mipi_dsi_stop_video(dsi);
 	rzg2l_mipi_dsi_stop_hs_clock(dsi);
 	rzg2l_mipi_dsi_stop(dsi);
+
+	/*
+	 * Drop the hand-over reference last, so that the put in
+	 * rzg2l_mipi_dsi_stop() does not runtime-suspend the device - and
+	 * assert its resets - before the stop sequence above has completed.
+	 */
+	rzg2l_mipi_dsi_finish_handover(dsi);
 }
 
 static enum drm_mode_status
@@ -1199,24 +1248,50 @@ static int rzg2l_mipi_dsi_probe(struct platform_device *pdev)
 
 	platform_set_drvdata(pdev, dsi);
 
+	dsi->boot_logo_handover =
+		of_property_read_bool(dsi->dev->of_node,
+				      "renesas,seamless-boot-logo");
+
 	pm_runtime_enable(dsi->dev);
 
+	if (dsi->boot_logo_handover) {
+		/*
+		 * The bootloader left the link transmitting.  Hold the device
+		 * resumed until the first modeset, otherwise the put below
+		 * would runtime-suspend it and rzg2l_mipi_pm_runtime_suspend()
+		 * would assert MIPI_DSI_ARESET_N/PRESET_N under the running
+		 * video channel.
+		 */
+		ret = pm_runtime_resume_and_get(dsi->dev);
+		if (ret < 0) {
+			dsi->boot_logo_handover = false;
+			goto err_pm_disable;
+		}
+	}
+
 	ret = pm_runtime_resume_and_get(dsi->dev);
 	if (ret < 0)
-		goto err_pm_disable;
+		goto err_handover_put;
 
 	/*
 	 * TXSETR register can be read only after DPHY init. But during probe
 	 * mode->clock and format are not available. So initialize DPHY with
 	 * timing parameters for 80Mbps.
+	 *
+	 * On a boot logo hand-over the D-PHY is already initialised for the
+	 * real mode, and re-initialising it for 80Mbps - then powering it down
+	 * again in dphy_exit() - would kill the link, so read TXSETR directly.
 	 */
-	ret = dsi->info->dphy_init(dsi, 80000000ULL * MILLI);
-	if (ret < 0)
-		goto err_phy;
+	if (!dsi->boot_logo_handover) {
+		ret = dsi->info->dphy_init(dsi, 80000000ULL * MILLI);
+		if (ret < 0)
+			goto err_phy;
+	}
 
 	txsetr = rzg2l_mipi_dsi_link_read(dsi, TXSETR);
 	dsi->num_data_lanes = min(((txsetr >> 16) & 3) + 1, num_data_lanes);
-	dsi->info->dphy_exit(dsi);
+	if (!dsi->boot_logo_handover)
+		dsi->info->dphy_exit(dsi);
 	pm_runtime_put(dsi->dev);
 
 	/* Initialize the DRM bridge. */
@@ -1228,7 +1303,7 @@ static int rzg2l_mipi_dsi_probe(struct platform_device *pdev)
 	dsi->host.ops = &rzg2l_mipi_dsi_host_ops;
 	ret = mipi_dsi_host_register(&dsi->host);
 	if (ret < 0)
-		goto err_pm_disable;
+		goto err_handover_put;
 
 	dsi->dcs_buf_virt = dma_alloc_coherent(dsi->host.dev, RZG2L_DCS_BUF_SIZE,
 					       &dsi->dcs_buf_phys, GFP_KERNEL);
@@ -1240,6 +1315,8 @@ static int rzg2l_mipi_dsi_probe(struct platform_device *pdev)
 err_phy:
 	dsi->info->dphy_exit(dsi);
 	pm_runtime_put(dsi->dev);
+err_handover_put:
+	rzg2l_mipi_dsi_finish_handover(dsi);
 err_pm_disable:
 	pm_runtime_disable(dsi->dev);
 	return ret;
@@ -1252,6 +1329,7 @@ static void rzg2l_mipi_dsi_remove(struct platform_device *pdev)
 	dma_free_coherent(dsi->host.dev, RZG2L_DCS_BUF_SIZE, dsi->dcs_buf_virt,
 			  dsi->dcs_buf_phys);
 	mipi_dsi_host_unregister(&dsi->host);
+	rzg2l_mipi_dsi_finish_handover(dsi);
 	pm_runtime_disable(&pdev->dev);
 }
 
