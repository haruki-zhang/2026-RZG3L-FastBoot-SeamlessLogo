--- a/drivers/video/rzg2l/rzg2l_video.c
+++ b/drivers/video/rzg2l/rzg2l_video.c
@@ -1,6 +1,7 @@
 #include "rzg2l_video.h"
 #include <common.h>
 #include <command.h>
+#include <env.h>
 
 // PFC
 #define PFC_BASE	0x11030000
@@ -56,6 +57,60 @@
 
 #define USE_DISPLAY_LIST
 
+/* ------------------------------------------------------------------------
+ * Boot logo intro
+ * ------------------------------------------------------------------------
+ * The VSPD walks a chain of display list headers on its own: each header
+ * names the header for the next frame in pNext_header, and flags bit 0
+ * (next_frame_auto_start) tells it to carry on when the current frame is
+ * done.  Point each header's body at a different frame buffer and the
+ * hardware plays an animation with no CPU involvement at all - through the
+ * rest of U-Boot, and through the whole of the kernel's boot.
+ *
+ * One header is consumed per output frame, so a frame is held on screen by
+ * repeating its header LOGO_REFRESH_HZ * rate_ms / 1000 times.  Headers are
+ * 96 bytes, so even a slow intro costs a few tens of kilobytes.
+ *
+ * The chain is a one-shot: the last header points at itself, parking the
+ * intro on its final frame.  That is what makes the hand-over to Linux
+ * deterministic - the player takes over from a known frame no matter how
+ * long the kernel took to boot.
+ */
+#define LOGO_LOAD_ADDR		0x48000000
+
+#if (DISPLAY_MODE == MIPI_DSI_1080P)
+#define LOGO_FILE_PREFIX	"boot_img_1080p"
+#else
+#define LOGO_FILE_PREFIX	"boot_img_720p"
+#endif
+
+/* Output frame rate. CEA VIC 16 and VIC 4 are both exactly 60 Hz. */
+#define LOGO_REFRESH_HZ		60
+
+/*
+ * Compiled-in defaults. Both are overridden at run time by the "logo_frames"
+ * and "logo_rate_ms" environment variables, so the intro can be retuned with
+ * setenv/saveenv instead of a rebuild and a re-flash of fip.
+ */
+#define LOGO_FRAMES_DEFAULT	4
+#define LOGO_RATE_MS_DEFAULT	400
+
+/* Frame buffers run from LCD_SRCM_ADDR up to the display list header area. */
+#define LOGO_FRAMES_MAX \
+	((unsigned int)((DISPLAY_LIST_HEADER_0 - LCD_SRCM_ADDR) / LCD_SRCM_ADDR_OFFS))
+
+/*
+ * Headers are laid out contiguously from DISPLAY_LIST_HEADER_0: index 0 is the
+ * one carrying the full pipeline configuration, 1.. are the chain.  The area
+ * up to DISPLAY_LIST_0 is 8 MiB, which is four orders of magnitude more than
+ * any sane intro needs, but bound it anyway.
+ */
+#define LOGO_HEADERS_MAX \
+	((unsigned int)((DISPLAY_LIST_0 - DISPLAY_LIST_HEADER_0) / sizeof(display_header_t)))
+
+#define LOGO_RATE_MS_MIN	(1000 / LOGO_REFRESH_HZ)
+#define LOGO_RATE_MS_MAX	10000
+
 static void rzg2l_cpg_init(void);
 static void adv7535_init(void);
 static void adv7535_deinit(void);
@@ -67,13 +122,16 @@
 static void rzg2l_vcpd_dl_init(void);
 static void rzg2l_lcdc_start(void);
 static void rzg2l_wait_frames(unsigned int frames, unsigned int timeout_ms);
+static void rzg2l_logo_read_config(unsigned int *frames, unsigned int *repeats);
+static int rzg2l_logo_load_frame(unsigned int index);
+static void rzg2l_logo_build_chain(unsigned int frames, unsigned int repeats);
 
 static void rzg2ul_adv7513_init(void);
 static int adv7513_i2c_reg_write(struct udevice *dev, uint addr, uint mask, uint data);
 static int adv7513_i2c_reg_read(struct udevice *dev, uint8_t addr, uint8_t *data);
 
 int rzg2l_video_init(void){
-	int ret;
+	unsigned int frames, repeats, i;
 
 	// adv7535_deinit();
 	rzg2l_cpg_init();
@@ -107,22 +165,19 @@
 	adv7535_init();
 #endif
 
+	rzg2l_logo_read_config(&frames, &repeats);
+
 	/*
-	 * Load the splash image.  It is installed in /boot on the rootfs
-	 * partition, next to Image and the device tree, so the same ext4
-	 * partition serves every file U-Boot reads.  Partition 1 is the vfat
-	 * "bootloader" partition of the BSP image layout and ext4load cannot
-	 * mount it.
+	 * Load the intro's first frame and bring the pipeline up on it.  The
+	 * remaining frames are loaded afterwards, behind a picture that is
+	 * already on screen, so the time to first pixel does not change.
+	 *
+	 * The files are installed in /boot on the rootfs partition, next to
+	 * Image and the device tree, so the same ext4 partition serves every
+	 * file U-Boot reads.  Partition 1 is the vfat "bootloader" partition of
+	 * the BSP image layout and ext4load cannot mount it.
 	 */
-#if (DISPLAY_MODE == MIPI_DSI_1080P)
-	ret = run_command("ext4load mmc 0:2 0x48000000 boot/boot_img_1080p.bin.gz", 0);
-#else
-	ret = run_command("ext4load mmc 0:2 0x48000000 boot/boot_img_720p.bin.gz", 0);
-#endif
-	if (!ret)
-		ret = run_command("unzip 0x48000000 0x58000000", 0);
-
-	if (ret) {
+	if (rzg2l_logo_load_frame(0)) {
 		/*
 		 * Start the pipeline anyway, on a blanked frame buffer.  The
 		 * device tree tells the kernel that the bootloader handed it a
@@ -134,6 +189,7 @@
 		printf("fast-logo: no splash image, showing a blank screen\n");
 		memset((void *)(unsigned long)LCD_SRCM_ADDR, 0,
 		       LCD_SRCM_ADDR_OFFS);
+		frames = 1;
 	}
 
 	dcache_disable();
@@ -160,9 +216,87 @@
 	 */
 	rzg2l_wait_frames(2, 100);
 
+#ifdef	USE_DISPLAY_LIST
+	/*
+	 * Frame 0 is on screen.  Load the rest of the intro and hand it to the
+	 * VSPD as a self-advancing chain.  A frame that will not load simply
+	 * ends the intro early rather than aborting it - a short animation is
+	 * a much better failure than a dead one.
+	 */
+	for (i = 1; i < frames; i++) {
+		if (rzg2l_logo_load_frame(i)) {
+			printf("fast-logo: frame %u did not load, intro cut to %u frame(s)\n",
+			       i, i);
+			frames = i;
+			break;
+		}
+	}
+
+	if (frames > 1)
+		rzg2l_logo_build_chain(frames, repeats);
+#endif	/* USE_DISPLAY_LIST */
+
 	return 0;
 }
 
+/*
+ * Number of frames in the intro and how long each is held, from the
+ * environment so that retuning the animation needs neither a rebuild nor a
+ * re-flash of fip.  Frame 0 is a special case: it goes up with the pipeline
+ * and stays until the chain is armed, which is however long the remaining
+ * frames take to load.  @repeats applies to frames 1..frames-1.
+ */
+static void rzg2l_logo_read_config(unsigned int *frames, unsigned int *repeats)
+{
+	unsigned long n, rate;
+
+	n = env_get_ulong("logo_frames", 10, LOGO_FRAMES_DEFAULT);
+	if (n < 1)
+		n = 1;
+	if (n > LOGO_FRAMES_MAX)
+		n = LOGO_FRAMES_MAX;
+
+	rate = env_get_ulong("logo_rate_ms", 10, LOGO_RATE_MS_DEFAULT);
+	if (rate < LOGO_RATE_MS_MIN)
+		rate = LOGO_RATE_MS_MIN;
+	if (rate > LOGO_RATE_MS_MAX)
+		rate = LOGO_RATE_MS_MAX;
+
+	*frames = (unsigned int)n;
+	*repeats = (unsigned int)((rate * LOGO_REFRESH_HZ) / 1000);
+	if (*repeats < 1)
+		*repeats = 1;
+
+	/*
+	 * One header per repeat per frame, plus the configuration header.
+	 * Trim the intro rather than run off the end of the header area.
+	 */
+	while (*frames > 1 &&
+	       1 + (*frames - 1) * (*repeats) > LOGO_HEADERS_MAX)
+		(*frames)--;
+
+	printf("fast-logo: %u frame intro, %lu ms per frame\n", *frames, rate);
+}
+
+/* Load one gzip-compressed XRGB8888 frame into its slot in the reserved area. */
+static int rzg2l_logo_load_frame(unsigned int index)
+{
+	char cmd[128];
+	int ret;
+
+	snprintf(cmd, sizeof(cmd),
+		 "ext4load mmc 0:2 0x%08x boot/" LOGO_FILE_PREFIX "_%02u.bin.gz",
+		 LOGO_LOAD_ADDR, index);
+	ret = run_command(cmd, 0);
+	if (ret)
+		return ret;
+
+	snprintf(cmd, sizeof(cmd), "unzip 0x%08x 0x%08lx", LOGO_LOAD_ADDR,
+		 (unsigned long)LCD_SRCM_ADDR +
+		 (unsigned long)LCD_SRCM_ADDR_OFFS * index);
+	return run_command(cmd, 0);
+}
+
 static const uint32_t cpg_register_values[][2] = {//0x11010000  //step1
 #if (DISPLAY_MODE == PARALLEL_RGB_720P)
 	{0x11010084, 0x104C4000}, // CPG_PLL7_CLK1
@@ -878,85 +1012,115 @@
 	//{VSPD_VI6_LIF0_PADLN_SIZE,	((uint32_t)0)},
 };
 
-static display_header_t *dl_headers[3];
-static display_body_t *dl_body[3];
+/*
+ * Headers are a contiguous array from DISPLAY_LIST_HEADER_0.  Index 0 carries
+ * the full pipeline configuration and frame 0; 1.. are the intro chain.  One
+ * single-entry body per frame lives at DISPLAY_LIST_1 and is shared by every
+ * header repeating that frame.
+ */
+static display_header_t * const dl_headers =
+	(display_header_t *)(unsigned long)DISPLAY_LIST_HEADER_0;
+static display_body_t * const dl_body_init =
+	(display_body_t *)(unsigned long)DISPLAY_LIST_0;
+static display_body_t * const dl_body_frame =
+	(display_body_t *)(unsigned long)DISPLAY_LIST_1;
 
 static void rzg2l_vcpd_dl_init(void)
 {
-	int i;
+	unsigned int i;
 	display_header_t *header;
 	display_body_t *body;
 
 	printf("VCPD Init for DL\r\n");
 	rzg2l_registers_set(vcpd_dl_register_values,ARRAY_SIZE(vcpd_dl_register_values));
 
-	/* Init DL */
