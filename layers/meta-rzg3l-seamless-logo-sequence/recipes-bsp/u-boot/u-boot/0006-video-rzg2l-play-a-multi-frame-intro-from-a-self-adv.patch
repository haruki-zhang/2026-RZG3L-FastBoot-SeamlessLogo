-	body = dl_body[1];
-	body->address = VSPD_VI6_RPF0_SRCM_ADDR_Y;
-	body->data = LCD_SRCM_ADDR;
-	body = dl_body[2];
-	body->address = VSPD_VI6_RPF0_SRCM_ADDR_Y;
-	body->data = LCD_SRCM_ADDR;
 
-	/* Setup DL headers */
-	header = dl_headers[0];
+	/*
+	 * Header 0 loops onto itself, so the pipeline comes up holding frame 0
+	 * for as long as it takes to load the rest of the intro.  Arming the
+	 * chain is a single store to this header's pNext_header, which the
+	 * hardware picks up at the next frame boundary - no register write, no
