 }
 
-void rzg2l_video_update(void)
+/*
+ * Build the intro chain for frames 1..frames-1 and arm it.
+ *
+ * Each frame gets @repeats consecutive headers, all sharing one body, so the
+ * frame stays on screen for @repeats output frames.  The last header points at
+ * itself: the intro plays once and parks, which is what lets the Linux player
+ * take over from a known frame however long the kernel takes to boot.
+ *
+ * Called with the pipeline already running.  The VSPD is a bus master reading
+ * these structures directly, so they are written with the D-cache off - the
+ * disable flushes the frame data written above at the same time.
+ */
+static void rzg2l_logo_build_chain(unsigned int frames, unsigned int repeats)
 {
-	display_header_t *header;
-	display_body_t *body;
-	static int count = 0;
+	unsigned int n = 1 + (frames - 1) * repeats;
+	unsigned int i, k, r;
 
-	count++;
-	if (count >= LCD_SRCM_FB_NUM)
-		return;
+	dcache_disable();
 
-	header = ((count & 1) == 0) ? dl_headers[1]: dl_headers[2];
-	body = (display_body_t *)header->list[0].pList;
+	/* One body per frame; frame 0's address is already in dl_init. */
+	for (k = 1; k < frames; k++) {
+		dl_body_frame[k].address = VSPD_VI6_RPF0_SRCM_ADDR_Y;
+		dl_body_frame[k].data = LCD_SRCM_ADDR + LCD_SRCM_ADDR_OFFS * k;
+	}
 
-	dcache_disable();
+	i = 1;
+	for (k = 1; k < frames; k++) {
+		for (r = 0; r < repeats; r++, i++) {
+			display_header_t *header = &dl_headers[i];
+
+			memset(header, 0x00, sizeof (display_header_t));
+			header->num_list = 0;
+			header->list[0].num_bytes = sizeof (display_body_t);
+			header->list[0].pList =
+				(uint32_t)(unsigned long)&dl_body_frame[k];
+			/* Last header parks the intro on the final frame. */
+			header->pNext_header = (uint32_t)(unsigned long)
+				&dl_headers[(i + 1 < n) ? i + 1 : i];
+			header->flags = 1;
+		}
+	}
 
-	body->data = LCD_SRCM_ADDR + LCD_SRCM_ADDR_OFFS * count;
-	reg_write(VSPD_VI6_DL_HDR_ADDR0, (uint32_t)header);
+	/* Arm. From here the animation runs without the CPU. */
+	dl_headers[0].pNext_header = (uint32_t)(unsigned long)&dl_headers[1];
 
 	dcache_enable();
+
+	printf("fast-logo: intro armed, %u headers, parks on frame %u\n",
+	       n, frames - 1);
+}
+
+/*
+ * Kept because cmd/booti.c and common/autoboot.c call it.
+ *
+ * It used to ping-pong two display list headers from the CPU, one call per
+ * frame.  The intro is a hardware-walked chain now (rzg2l_logo_build_chain),
+ * which needs no help and, unlike this, keeps animating after U-Boot has
+ * handed over to the kernel.  Stepping the chain from here would only fight
+ * it, so this does nothing.
+ */
+void rzg2l_video_update(void)
+{
 }
 
