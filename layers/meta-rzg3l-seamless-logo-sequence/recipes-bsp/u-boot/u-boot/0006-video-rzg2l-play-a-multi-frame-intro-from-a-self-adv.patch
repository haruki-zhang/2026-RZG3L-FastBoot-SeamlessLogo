+	 */
+	header = &dl_headers[0];
+	memset(header, 0x00, sizeof (display_header_t));
 	header->num_list = 0;
 	header->list[0].num_bytes = (sizeof dl_init);
-	header->list[0].pList = (uint32_t)dl_body[0];
-	header->pNext_header = DISPLAY_LIST_HEADER_1;
