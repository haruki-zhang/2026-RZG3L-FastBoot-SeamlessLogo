+ */
+#ifndef RZG2L_LOGO_RATE_MS
+#define RZG2L_LOGO_RATE_MS	1000
+#endif
+#define LOGO_RATE_MS_DEFAULT	RZG2L_LOGO_RATE_MS
+
+/*
+ * The number of frames is not compiled in.  The intro is frame 00, 01, ... up
+ * to the first number that has no file, so replacing the artwork with more or
+ * fewer frames only changes the rootfs.  "logo_frames" in the environment can
+ * cap the count below what is installed.
  */
-#define LOGO_FRAMES_DEFAULT	4
-#define LOGO_RATE_MS_DEFAULT	400
 
 /* Frame buffers run from LCD_SRCM_ADDR up to the display list header area. */
 #define LOGO_FRAMES_MAX \
@@ -152,17 +164,21 @@ static void rzg2l_vcpd_init(void);
 static void rzg2l_vcpd_dl_init(void);
