@@ -360,14 +401,26 @@ static unsigned int rzg2l_logo_mmc_dev(void)
 	return run_command("mmc dev 1", 0) == 0 ? 1u : 0u;
 }
 
-/* Load one gzip-compressed XRGB8888 frame into its slot in the reserved area. */
+/*
+ * Load one gzip-compressed XRGB8888 frame into its slot in the reserved area.
+ *
+ * Returns -ENOENT, without a word on the console, when the file does not
+ * exist: that is how the intro normally ends, and ext4load would otherwise
+ * report it as an error on every boot.
+ */
 static int rzg2l_logo_load_frame(unsigned int dev, unsigned int index)
 {
-	char cmd[128];
+	char part[16], path[64], cmd[128];
 	int ret;
 
-	snprintf(cmd, sizeof(cmd), "ext4load mmc %u:2 0x%08x " LOGO_FILE_FMT,
-		 dev, LOGO_LOAD_ADDR, LCD_HACTIVE, LCD_VACTIVE, index);
+	snprintf(part, sizeof(part), "%u:2", dev);
+	snprintf(path, sizeof(path), LOGO_FILE_FMT, LCD_HACTIVE, LCD_VACTIVE,
+		 index);
+	if (!file_exists("mmc", part, path, FS_TYPE_EXT))
+		return -ENOENT;
+
+	snprintf(cmd, sizeof(cmd), "ext4load mmc %s 0x%08x %s", part,
+		 LOGO_LOAD_ADDR, path);
 	ret = run_command(cmd, 0);
 	if (ret)
 		return ret;
@@ -1159,33 +1212,36 @@ static void rzg2l_vcpd_dl_init(void)
 }
 
 /*
- * Build the intro chain for frames 1..frames-1 and arm it.
+ * Build the intro chain and arm it.
  *
- * Each frame gets @repeats consecutive headers, all sharing one body, so the
- * frame stays on screen for @repeats output frames.  The last header points at
- * itself: the intro plays once and parks, which is what lets the Linux player
- * take over from a known frame however long the kernel takes to boot.
+ * Frame 0 is already on screen, through header 0; it gets @first more
+ * headers to make up the rest of its time.  Every other frame gets @repeats
+ * consecutive headers, all sharing one body, so it stays on screen for
+ * @repeats output frames.  The last header points at itself: the intro plays
+ * once and parks, which is what lets a Linux application take over from a
+ * known frame however long the kernel takes to boot.
  *
  * Called with the pipeline already running.  The VSPD is a bus master reading
  * these structures directly, so they are written with the D-cache off - the
  * disable flushes the frame data written above at the same time.
  */
-static void rzg2l_logo_build_chain(unsigned int frames, unsigned int repeats)
+static void rzg2l_logo_build_chain(unsigned int frames, unsigned int first,
+				   unsigned int repeats)
 {
-	unsigned int n = 1 + (frames - 1) * repeats;
+	unsigned int n = 1 + first + (frames - 1) * repeats;
 	unsigned int i, k, r;
 
 	dcache_disable();
 
-	/* One body per frame; frame 0's address is already in dl_init. */
-	for (k = 1; k < frames; k++) {
+	/* One body per frame. */
+	for (k = 0; k < frames; k++) {
 		dl_body_frame[k].address = VSPD_VI6_RPF0_SRCM_ADDR_Y;
 		dl_body_frame[k].data = LCD_SRCM_ADDR + LCD_SRCM_ADDR_OFFS * k;
 	}
 
 	i = 1;
-	for (k = 1; k < frames; k++) {
-		for (r = 0; r < repeats; r++, i++) {
+	for (k = 0; k < frames; k++) {
+		for (r = 0; r < (k ? repeats : first); r++, i++) {
 			display_header_t *header = &dl_headers[i];
 
 			memset(header, 0x00, sizeof (display_header_t));
