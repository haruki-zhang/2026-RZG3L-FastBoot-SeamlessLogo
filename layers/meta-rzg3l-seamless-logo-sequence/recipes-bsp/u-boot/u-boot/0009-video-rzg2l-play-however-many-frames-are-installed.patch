 int rzg2l_video_init(void){
-	unsigned int frames, repeats, i, dev;
+	unsigned int frames, repeats, first, i, dev;
+	unsigned long rate, lit, elapsed;
+	bool capped, blank = false;
 	int ret;
 
 	// adv7535_deinit();
@@ -197,7 +213,7 @@ int rzg2l_video_init(void){
 	adv7535_init();
 #endif
 
-	rzg2l_logo_read_config(&frames, &repeats);
+	rzg2l_logo_read_config(&frames, &repeats, &rate, &capped);
 
 	/*
 	 * Load the intro's first frame and bring the pipeline up on it.  The
@@ -240,6 +256,7 @@ int rzg2l_video_init(void){
 		memset((void *)(unsigned long)LCD_SRCM_ADDR, 0,
 		       LCD_SRCM_ADDR_OFFS);
 		frames = 1;
+		blank = true;
 	} else {
 		printf("fast-logo: intro from mmc %u:2\n", dev);
 	}
@@ -259,6 +276,7 @@ int rzg2l_video_init(void){
 	dcache_enable();
 
 	rzg2l_lcdc_start();
+	lit = get_timer(0);
 
 	/*
 	 * Let the first frame buffer image reach the screen before U-Boot
@@ -271,38 +289,55 @@ int rzg2l_video_init(void){
 #ifdef	USE_DISPLAY_LIST
 	/*
 	 * Frame 0 is on screen.  Load the rest of the intro and hand it to the
-	 * VSPD as a self-advancing chain.  A frame that will not load simply
-	 * ends the intro early rather than aborting it - a short animation is
-	 * a much better failure than a dead one.
+	 * VSPD as a self-advancing chain.  Running out of files is how the
+	 * intro normally ends.  A frame that exists but will not load ends it
+	 * early rather than aborting it - a short animation is a much better
+	 * failure than a dead one.
 	 */
 	for (i = 1; i < frames; i++) {
-		if (rzg2l_logo_load_frame(dev, i)) {
+		ret = rzg2l_logo_load_frame(dev, i);
+		if (ret == -ENOENT && !capped)
+			break;
+		if (ret) {
 			printf("fast-logo: frame %u did not load, intro cut to %u frame(s)\n",
 			       i, i);
-			frames = i;
 			break;
 		}
 	}
+	frames = i;
+
+	/*
+	 * Frame 0 has been up since the pipeline started, while the others
+	 * loaded.  Hold it for whatever is left of its share, so that it gets
+	 * the same time on screen as every other frame.
+	 */
+	elapsed = get_timer(lit);
+	first = elapsed < rate ?
+		(unsigned int)(((rate - elapsed) * LOGO_REFRESH_HZ) / 1000) : 0;
+
+	if (!blank)
+		printf("fast-logo: intro is %u frame(s)\n", frames);
 
 	if (frames > 1)
-		rzg2l_logo_build_chain(frames, repeats);
+		rzg2l_logo_build_chain(frames, first, repeats);
 #endif	/* USE_DISPLAY_LIST */
 
 	return 0;
 }
 
 /*
- * Number of frames in the intro and how long each is held, from the
- * environment so that retuning the animation needs neither a rebuild nor a
- * re-flash of fip.  Frame 0 is a special case: it goes up with the pipeline
- * and stays until the chain is armed, which is however long the remaining
- * frames take to load.  @repeats applies to frames 1..frames-1.
+ * How long each frame is held and, optionally, a cap on the number of frames,
+ * from the environment so that retuning the animation needs neither a rebuild
+ * nor a re-flash of fip.  Without "logo_frames" the cap is the room in the
+ * reserved area, and the intro is however many frames are installed.
  */
-static void rzg2l_logo_read_config(unsigned int *frames, unsigned int *repeats)
+static void rzg2l_logo_read_config(unsigned int *frames, unsigned int *repeats,
+				   unsigned long *rate_ms, bool *capped)
 {
 	unsigned long n, rate;
 
-	n = env_get_ulong("logo_frames", 10, LOGO_FRAMES_DEFAULT);
+	*capped = env_get("logo_frames") != NULL;
+	n = env_get_ulong("logo_frames", 10, LOGO_FRAMES_MAX);
 	if (n < 1)
 		n = 1;
 	if (n > LOGO_FRAMES_MAX)
@@ -315,19 +350,25 @@ static void rzg2l_logo_read_config(unsigned int *frames, unsigned int *repeats)
 		rate = LOGO_RATE_MS_MAX;
 
 	*frames = (unsigned int)n;
+	*rate_ms = rate;
 	*repeats = (unsigned int)((rate * LOGO_REFRESH_HZ) / 1000);
 	if (*repeats < 1)
 		*repeats = 1;
 
 	/*
-	 * One header per repeat per frame, plus the configuration header.
-	 * Trim the intro rather than run off the end of the header area.
+	 * At most one header per repeat per frame - frame 0's share included -
+	 * plus the configuration header.  Trim the intro rather than run off
+	 * the end of the header area.
 	 */
 	while (*frames > 1 &&
-	       1 + (*frames - 1) * (*repeats) > LOGO_HEADERS_MAX)
+	       1 + (*frames) * (*repeats) > LOGO_HEADERS_MAX)
 		(*frames)--;
 
-	printf("fast-logo: %u frame intro, %lu ms per frame\n", *frames, rate);
+	if (*capped)
+		printf("fast-logo: up to %u frame(s), %lu ms per frame\n",
+		       *frames, rate);
+	else
+		printf("fast-logo: %lu ms per frame\n", rate);
 }
 
