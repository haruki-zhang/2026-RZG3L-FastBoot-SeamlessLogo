From b19ddd538ca704c5b4647c988a9511ca506a1f1f Mon Sep 17 00:00:00 2001
From: Zixuan Zhang <zixuan.zhang.uj@renesas.com>
Date: Tue, 29 Sep 2026 18:13:45 +0900
Subject: [PATCH] video: rzg2l: declare the hand-over to the kernel from the
 bootloader

The kernel drivers on the VSPD -> DU -> MIPI DSI -> ADV7535 path inherit
the running pipeline only when their device tree node carries
"renesas,seamless-boot-logo".  Until now the board .dts declared it
unconditionally, which makes the kernel's behaviour depend on a promise
nobody checks: boot that kernel with the BSP's own fip, or an old one,
and every driver skips its modeset on a pipeline that was never started,
so HDMI stays dark for the lifetime of the system.  The only party that
knows whether the pipeline is running is this driver.

So let it say so.  At boot, it adds to the tree handed to the kernel:

  - "renesas,seamless-boot-logo" on the VSPD, DU, DSI and ADV7535 nodes;
  - "renesas,seamless-boot-logo-vic" on the ADV7535, set to the CEA VIC
    of the timing table in use (LCD_CEA_VIC), which is what pins the
    connector to the mode being scanned out;
  - and it deletes the ADV7535's "interrupts-extended": with the
    connector pinned, a hot-plug event could only re-probe a bridge the
    kernel must leave alone.

The board .dts then stays stock, and the resolution becomes a decision
made in one place: a kernel image no longer has to be rebuilt to match
the bootloader's mode.

The hook is ft_system_setup(), with CONFIG_OF_SYSTEM_SETUP turned on in
smarc-rzg3l_defconfig; image_setup_libfdt() calls it with the tree being
booted.  Two other hooks look more natural and do not work here:

  - EVT_FT_FIXUP is only raised when oftree_from_fdt() accepts the tree.
    Without OF_LIVE this board has DM_DEV_READ_INLINE, which keeps
    OFNODE_MULTI_TREE off, and then oftree_from_fdt() only accepts
    U-Boot's own control tree - the event is never raised for the
    kernel's, and nothing is declared.  Turning OFNODE_MULTI_TREE on
    would change how every ofnode in U-Boot is encoded.
  - ft_board_setup() is already defined by board/renesas/rcar-common,
    and OF_BOARD_SETUP is off for RZ/G3L on purpose: its fix-ups expect
    an FDT from TF-A that TF-A on this SoC does not provide.

No other RZ code provides ft_system_setup(), so enabling it changes
nothing else.  It never fails: a non-zero return would abort the boot.

The declaration is made only for a pipeline that demonstrably started:
the VSPD raised display start, the DSI link saw video input and two more
frames went out.  The two waits in rzg2l_lcdc_start() were unbounded
spins, so a display path that never started hung U-Boot and the whole
boot with it; they are now bounded at 500 ms, and a timeout leaves the
display to the kernel.  It is also all or nothing - every node must be
present and the bridge must be an ADV7535, and a failed write undoes
the ones before it - because a hand-over declared on part of the path
would have one driver inherit the pipeline while the next one resets
it.  Every path that declares nothing says why on the console.

"logo_handover=no" in the environment skips the declaration, for
comparing against a stock kernel bring-up.  Like the other logo_*
variables it is read at power-on, because the BSP's bootcmd starts with
"env default -a".

Upstream-Status: Inappropriate [RZ/G3L boot logo, board specific]

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 configs/smarc-rzg3l_defconfig     |   1 +
 drivers/video/rzg2l/rzg2l_video.c | 224 ++++++++++++++++++++++++++++--
 2 files changed, 212 insertions(+), 13 deletions(-)

diff --git a/configs/smarc-rzg3l_defconfig b/configs/smarc-rzg3l_defconfig
index fa20afce06..a07fdeb7b8 100644
--- a/configs/smarc-rzg3l_defconfig
+++ b/configs/smarc-rzg3l_defconfig
@@ -3,6 +3,7 @@ CONFIG_SYS_LOAD_ADDR=0x58000000
 CONFIG_TEXT_BASE=0x50000000
 CONFIG_OF_UPSTREAM=n
 CONFIG_OF_BOARD_SETUP=n
+CONFIG_OF_SYSTEM_SETUP=y
 
 CONFIG_SYS_MONITOR_LEN=1048576
 CONFIG_SYS_MALLOC_LEN=0x4000000
diff --git a/drivers/video/rzg2l/rzg2l_video.c b/drivers/video/rzg2l/rzg2l_video.c
index 51ea9d7d65..6ed08f0df5 100644
--- a/drivers/video/rzg2l/rzg2l_video.c
+++ b/drivers/video/rzg2l/rzg2l_video.c
@@ -2,8 +2,10 @@
 #include <common.h>
 #include <command.h>
 #include <env.h>
+#include <fdt_support.h>
 #include <fs.h>
 #include <linux/errno.h>
+#include <linux/libfdt.h>
 
 // PFC
 #define PFC_BASE	0x11030000
@@ -153,6 +155,11 @@
 /* "logo_mmc_dev" unset: work the boot medium out at run time. */
 #define LOGO_MMC_DEV_AUTO	(~0UL)
 
+/* Set once the pipeline has started and output frames; see rzg2l_logo_ft_fixup(). */
+static bool rzg2l_logo_running;
+/* "logo_handover=no": leave the display to the kernel; see rzg2l_logo_ft_fixup(). */
+static bool rzg2l_logo_handover_off;
+
 static void rzg2l_cpg_init(void);
 static void adv7535_init(void);
 static void adv7535_deinit(void);
@@ -162,8 +169,8 @@ static void rzg2l_fpvcg_init(void);
 static void rzg2l_du_init(void);
 static void rzg2l_vcpd_init(void);
 static void rzg2l_vcpd_dl_init(void);
-static void rzg2l_lcdc_start(void);
-static void rzg2l_wait_frames(unsigned int frames, unsigned int timeout_ms);
+static int rzg2l_lcdc_start(void);
+static int rzg2l_wait_frames(unsigned int frames, unsigned int timeout_ms);
 static void rzg2l_logo_read_config(unsigned int *frames, unsigned int *repeats,
 				   unsigned long *rate_ms, bool *capped);
 static unsigned int rzg2l_logo_mmc_dev(void);
@@ -246,10 +253,9 @@ int rzg2l_video_init(void){
 	if (ret) {
 		/*
 		 * Start the pipeline anyway, on a blanked frame buffer.  The
-		 * device tree tells the kernel that the bootloader handed it a
-		 * running display and every driver on the path skips its own
-		 * modeset, so leaving the LCDC off here would cost the Weston
-		 * splash too - and scanning out uninitialised DRAM would put
+		 * hand-over to the kernel works for a running pipeline
+		 * whatever it shows, so the compositor still comes up without
+		 * a re-sync - and scanning out uninitialised DRAM would put
 		 * noise on the screen instead of the missing logo.
 		 */
 		printf("fast-logo: no splash image, showing a blank screen\n");
@@ -275,7 +281,7 @@ int rzg2l_video_init(void){
 
 	dcache_enable();
 
-	rzg2l_lcdc_start();
+	ret = rzg2l_lcdc_start();
 	lit = get_timer(0);
 
 	/*
@@ -284,7 +290,25 @@ int rzg2l_video_init(void){
 	 * *start*, so wait for two more display-start events, i.e. two
 	 * complete output frames.
 	 */
-	rzg2l_wait_frames(2, 100);
+	if (!ret)
+		ret = rzg2l_wait_frames(2, 100);
+
+	/*
+	 * Only a pipeline that is demonstrably scanning out is declared to the
+	 * kernel as one to inherit - see rzg2l_logo_ft_fixup().  Anything else
+	 * and the kernel brings the display up the normal way.
+	 */
+	rzg2l_logo_running = !ret;
+	/*
+	 * Read now, like the other logo_* variables: the BSP's bootcmd starts
+	 * with "env default -a", so by the time booti runs a saved value is
+	 * gone.
+	 */
+	rzg2l_logo_handover_off = env_get_yesno("logo_handover") == 0;
+	if (ret) {
+		printf("fast-logo: display did not start, leaving it to the kernel\n");
+		return 0;
+	}
 
 #ifdef	USE_DISPLAY_LIST
 	/*
@@ -1278,17 +1302,48 @@ void rzg2l_video_update(void)
 {
 }
 
+/*
+ * Poll until (@addr & @mask) == @mask, for at most @timeout_ms.
+ *
+ * Both waits in rzg2l_lcdc_start() used to spin unbounded, so a display path
+ * that never started - a missing bridge, a bad timing table - hung U-Boot
+ * and took the whole boot with it.
+ */
+static int rzg2l_poll_set(unsigned long addr, uint32_t mask,
+			  unsigned int timeout_ms)
+{
+	unsigned long ts = get_timer(0);
+
+	while ((reg_read(addr) & mask) != mask) {
+		if (get_timer(ts) >= timeout_ms)
+			return -ETIMEDOUT;
+		udelay(100);
+	}
+
+	return 0;
+}
+
 /* Start LCDC */
-static void rzg2l_lcdc_start(void)
+static int rzg2l_lcdc_start(void)
 {
     //----- Start Video Output -----
     reg_write(VSPD_base_addr + 0x0000, 0x00000001); // VI6_CMD0: STRCMD=1
-    while ((reg_read(VSPD_base_addr + 0x007C) & 0x00000100) != 0x00000100);// Wait until VI6_DISP0_IRQ_STA.DST=1
+    // Wait until VI6_DISP0_IRQ_STA.DST=1
+    if (rzg2l_poll_set(VSPD_base_addr + 0x007C, 0x00000100, 500)) {
+        printf("fast-logo: VSPD display start timed out\n");
+        return -ETIMEDOUT;
+    }
 
 #if (DISPLAY_MODE != PARALLEL_RGB_720P)
     reg_write(DU_base_addr + 0x0000, 0x00000100);   // DU_MCR0 : DI_EN=1
-    while ((reg_read(DSI_LINK_base_addr + ISR) & 0x00000100) != 0x00000100);// ISR.VIN1
+    // ISR.VIN1
+    if (rzg2l_poll_set(DSI_LINK_base_addr + ISR, 0x00000100, 500)) {
+        printf("fast-logo: MIPI DSI video input timed out\n");
+        return -ETIMEDOUT;
+    }
 #endif
+
+    return 0;
 }
 
 /*
@@ -1308,7 +1363,7 @@ static void rzg2l_lcdc_start(void)
  * @timeout_ms bounds the wait so that a display that never starts turns into
  * a warning rather than a boot hang.
  */
-static void rzg2l_wait_frames(unsigned int frames, unsigned int timeout_ms)
+static int rzg2l_wait_frames(unsigned int frames, unsigned int timeout_ms)
 {
 	unsigned long ts = get_timer(0);
 
@@ -1319,9 +1374,152 @@ static void rzg2l_wait_frames(unsigned int frames, unsigned int timeout_ms)
 			 VI6_DISP_IRQ_STA_DST)) {
 			if (get_timer(ts) >= timeout_ms) {
 				printf("fast-logo: display start timed out\n");
-				return;
+				return -ETIMEDOUT;
 			}
 			udelay(100);
 		}
 	}
+
+	return 0;
+}
+
+/* ------------------------------------------------------------------------
+ * Hand-over to the kernel
+ * ------------------------------------------------------------------------
+ * The kernel drivers on the DRAM -> VSPD -> DU -> MIPI DSI -> ADV7535 path
+ * inherit a running pipeline, instead of re-creating it, only when their
+ * device tree node carries "renesas,seamless-boot-logo".  Only this driver
+ * knows whether there is a running pipeline to inherit, so it is the one that
+ * says so: the property goes into the tree handed to the kernel at boot, and
+ * never into the board .dts.
+ *
+ * The hook is ft_system_setup(), which image_setup_libfdt() calls with the
+ * tree being booted whenever CONFIG_OF_SYSTEM_SETUP is set.  Not the obvious
+ * EVT_FT_FIXUP event: on this board DM_DEV_READ_INLINE leaves
+ * OFNODE_MULTI_TREE off, so oftree_from_fdt() only accepts U-Boot's own
+ * control tree and the event is never raised for the kernel's.  Not
+ * ft_board_setup() either: rcar-common already defines it, and the BSP turns
+ * OF_BOARD_SETUP off for RZ/G3L on purpose.
+ *
+ * That keeps the declaration true.  A bootloader without this driver - the
+ * BSP's own fip, or an old one - leaves the tree alone, and the kernel brings
+ * the display up the normal way instead of skipping its modeset on a pipeline
+ * nobody started.  The same goes for a pipeline that failed to start here.
+ *
+ * The HDMI bridge also gets the CEA VIC of the mode being scanned out, which
+ * pins its connector to that mode, and loses its hot-plug interrupt: with the
+ * connector pinned, a hot-plug event could only re-probe a bridge the kernel
+ * must leave alone.
+ *
+ * "logo_handover=no" in the environment skips the declaration, for comparing
+ * against a stock kernel bring-up.
+ */
+#if !CONFIG_IS_ENABLED(OF_SYSTEM_SETUP)
+#error "the boot logo hand-over is declared from ft_system_setup(), which needs CONFIG_OF_SYSTEM_SETUP"
+#endif
+
+static const char * const rzg2l_logo_handover_nodes[] = {
+	"/soc/vsp@10870000",		/* VSPD */
+	"/soc/display@10890000",	/* DU */
+	"/soc/dsi@10850000",		/* MIPI DSI */
+	"/soc/i2c@10090800/hdmi@3d",	/* ADV7535 */
+};
+
+#define LOGO_HDMI_NODE		"/soc/i2c@10090800/hdmi@3d"
+#define LOGO_PROP_HANDOVER	"renesas,seamless-boot-logo"
+#define LOGO_PROP_VIC		"renesas,seamless-boot-logo-vic"
+
+/* Remove every property the fix-up adds, leaving the stock tree. */
+static void rzg2l_logo_ft_undo(void *blob)
+{
+	unsigned int i;
+	int off;
+
+	for (i = 0; i < ARRAY_SIZE(rzg2l_logo_handover_nodes); i++) {
+		off = fdt_path_offset(blob, rzg2l_logo_handover_nodes[i]);
+		if (off >= 0)
+			fdt_delprop(blob, off, LOGO_PROP_HANDOVER);
+	}
+
+	off = fdt_path_offset(blob, LOGO_HDMI_NODE);
+	if (off >= 0)
+		fdt_delprop(blob, off, LOGO_PROP_VIC);
+}
+
+static void rzg2l_logo_ft_fixup(void *blob)
+{
+	unsigned int i;
+	int off, ret = 0;
+
+	if (!rzg2l_logo_running) {
+		printf("fast-logo: display not running, hand-over not declared\n");
+		return;
+	}
+
+	if (rzg2l_logo_handover_off) {
+		printf("fast-logo: logo_handover=no, kernel brings the display up itself\n");
+		return;
+	}
+
+	/*
+	 * All or nothing.  A hand-over declared on some of the path only would
+	 * have one driver inherit the pipeline while the next one resets it.
+	 */
+	for (i = 0; i < ARRAY_SIZE(rzg2l_logo_handover_nodes); i++) {
+		if (fdt_path_offset(blob, rzg2l_logo_handover_nodes[i]) < 0) {
+			printf("fast-logo: no %s in the device tree, hand-over not declared\n",
+			       rzg2l_logo_handover_nodes[i]);
+			return;
+		}
+	}
+
+	off = fdt_path_offset(blob, LOGO_HDMI_NODE);
+	if (fdt_node_check_compatible(blob, off, "adi,adv7535")) {
+		printf("fast-logo: %s is not an ADV7535, hand-over not declared\n",
+		       LOGO_HDMI_NODE);
+		return;
+	}
+
+	/*
+	 * Offsets move whenever the blob is edited, so every node is looked up
+	 * again right before it is written.  A failure is not fatal to the
+	 * boot - a non-zero return here would abort it - but it must not leave
+	 * a partial declaration behind.
+	 */
+	for (i = 0; i < ARRAY_SIZE(rzg2l_logo_handover_nodes) && !ret; i++) {
+		off = fdt_path_offset(blob, rzg2l_logo_handover_nodes[i]);
+		ret = fdt_setprop_empty(blob, off, LOGO_PROP_HANDOVER);
+	}
+
+	if (!ret) {
+		off = fdt_path_offset(blob, LOGO_HDMI_NODE);
+		ret = fdt_setprop_u32(blob, off, LOGO_PROP_VIC, LCD_CEA_VIC);
+	}
+
+	if (!ret) {
+		off = fdt_path_offset(blob, LOGO_HDMI_NODE);
+		ret = fdt_delprop(blob, off, "interrupts-extended");
+		if (ret == -FDT_ERR_NOTFOUND)
+			ret = 0;
+	}
+
+	if (ret) {
+		rzg2l_logo_ft_undo(blob);
+		printf("fast-logo: could not declare the hand-over (%s), kernel brings the display up itself\n",
+		       fdt_strerror(ret));
+		return;
+	}
+
+	printf("fast-logo: hand-over declared to the kernel, CEA VIC %u\n",
+	       LCD_CEA_VIC);
+}
+
+/*
+ * Never fails: a non-zero return aborts the boot, and a boot logo that cannot
+ * be handed over is no reason not to boot.
+ */
+int ft_system_setup(void *blob, struct bd_info *bd)
+{
+	rzg2l_logo_ft_fixup(blob);
+	return 0;
 }
