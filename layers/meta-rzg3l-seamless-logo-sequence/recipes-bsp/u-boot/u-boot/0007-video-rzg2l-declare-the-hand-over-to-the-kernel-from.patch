From 8ebcb233514706df34118266acc638276a0fd72d Mon Sep 17 00:00:00 2001
From: Zixuan Zhang <zixuan.zhang.uj@renesas.com>
Date: Tue, 29 Sep 2026 18:13:45 +0900
Subject: [PATCH] video: rzg2l: declare the hand-over to the kernel from the
 bootloader

With a static declaration in the board .dts, an old fip leaves HDMI
dark: no display runs, but every driver skips its modeset. Add
"renesas,seamless-boot-logo" at boot instead, and only when the display
really started. logo_handover=no skips it.

Upstream-Status: Inappropriate [RZ/G3L boot logo, board specific]
---
 configs/smarc-rzg3l_defconfig     |   1 +
 drivers/video/rzg2l/rzg2l_video.c | 210 ++++++++++++++++++++++++++++--
 2 files changed, 199 insertions(+), 12 deletions(-)

diff --git a/configs/smarc-rzg3l_defconfig b/configs/smarc-rzg3l_defconfig
index fa20afce06..a07fdeb7b8 100644
--- a/configs/smarc-rzg3l_defconfig
+++ b/configs/smarc-rzg3l_defconfig
@@ -3,6 +3,7 @@ CONFIG_SYS_LOAD_ADDR=0x58000000
 CONFIG_TEXT_BASE=0x50000000
 CONFIG_OF_UPSTREAM=n
 CONFIG_OF_BOARD_SETUP=n
+CONFIG_OF_SYSTEM_SETUP=y
 
 CONFIG_SYS_MONITOR_LEN=1048576
 CONFIG_SYS_MALLOC_LEN=0x4000000
diff --git a/drivers/video/rzg2l/rzg2l_video.c b/drivers/video/rzg2l/rzg2l_video.c
index 524ff79709..86ae0013f4 100644
--- a/drivers/video/rzg2l/rzg2l_video.c
+++ b/drivers/video/rzg2l/rzg2l_video.c
@@ -2,8 +2,10 @@
 #include <common.h>
 #include <command.h>
 #include <env.h>
+#include <fdt_support.h>
 #include <fs.h>
 #include <linux/errno.h>
+#include <linux/libfdt.h>
 
 // PFC
 #define PFC_BASE	0x11030000
@@ -141,6 +143,11 @@
 /* "logo_mmc_dev" unset: work the boot medium out at run time. */
 #define LOGO_MMC_DEV_AUTO	(~0UL)
 
+/* Set once the pipeline has started and output frames; see rzg2l_logo_ft_fixup(). */
+static bool rzg2l_logo_running;
+/* "logo_handover=no": leave the display to the kernel; see rzg2l_logo_ft_fixup(). */
+static bool rzg2l_logo_handover_off;
+
 static void rzg2l_cpg_init(void);
 static void adv7535_init(void);
 static void adv7535_deinit(void);
@@ -150,8 +157,8 @@ static void rzg2l_fpvcg_init(void);
 static void rzg2l_du_init(void);
 static void rzg2l_vcpd_init(void);
 static void rzg2l_vcpd_dl_init(void);
-static void rzg2l_lcdc_start(void);
-static void rzg2l_wait_frames(unsigned int frames, unsigned int timeout_ms);
+static int rzg2l_lcdc_start(void);
+static int rzg2l_wait_frames(unsigned int frames, unsigned int timeout_ms);
 static void rzg2l_logo_read_config(unsigned int *frames, unsigned int *repeats,
 				   unsigned long *rate_ms, bool *capped);
 static unsigned int rzg2l_logo_mmc_dev(void);
@@ -227,9 +234,9 @@ int rzg2l_video_init(void){
 
 	if (ret) {
 		/*
-		 * Start the pipeline anyway, on a black frame. The device tree
-		 * declares the hand-over, so the kernel does not start the
-		 * display itself. Uninitialised DRAM would show noise.
+		 * Start the pipeline anyway, on a black frame. The kernel can
+		 * still take over a running display without an HDMI re-sync.
+		 * Uninitialised DRAM would show noise.
 		 */
 		printf("fast-logo: no splash image, showing a blank screen\n");
 		memset((void *)(unsigned long)LCD_SRCM_ADDR, 0,
@@ -254,14 +261,30 @@ int rzg2l_video_init(void){
 
 	dcache_enable();
 
-	rzg2l_lcdc_start();
+	ret = rzg2l_lcdc_start();
 	lit = get_timer(0);
 
 	/*
 	 * rzg2l_lcdc_start() only waits for the pipeline to start. Wait for
 	 * two full frames, so that the image is really on screen.
 	 */
-	rzg2l_wait_frames(2, 100);
+	if (!ret)
+		ret = rzg2l_wait_frames(2, 100);
+
+	/*
+	 * Declare the hand-over only for a pipeline that really outputs
+	 * frames. Otherwise the kernel starts the display itself.
+	 */
+	rzg2l_logo_running = !ret;
+	/*
+	 * Read now: the BSP bootcmd runs "env default -a", which drops saved
+	 * values before booti.
+	 */
+	rzg2l_logo_handover_off = env_get_yesno("logo_handover") == 0;
+	if (ret) {
+		printf("fast-logo: display did not start, leaving it to the kernel\n");
+		return 0;
+	}
 
 #ifdef	USE_DISPLAY_LIST
 	/*
@@ -1226,17 +1249,46 @@ void rzg2l_video_update(void)
 {
 }
 
+/*
+ * Poll until (@addr & @mask) == @mask, for at most @timeout_ms. Without a
+ * timeout, a display that never starts (missing bridge, bad timing table)
+ * would hang the boot.
+ */
+static int rzg2l_poll_set(unsigned long addr, uint32_t mask,
+			  unsigned int timeout_ms)
+{
+	unsigned long ts = get_timer(0);
+
+	while ((reg_read(addr) & mask) != mask) {
+		if (get_timer(ts) >= timeout_ms)
+			return -ETIMEDOUT;
+		udelay(100);
+	}
+
+	return 0;
+}
+
 /* Start LCDC */
-static void rzg2l_lcdc_start(void)
+static int rzg2l_lcdc_start(void)
 {
     //----- Start Video Output -----
     reg_write(VSPD_base_addr + 0x0000, 0x00000001); // VI6_CMD0: STRCMD=1
-    while ((reg_read(VSPD_base_addr + 0x007C) & 0x00000100) != 0x00000100);// Wait until VI6_DISP0_IRQ_STA.DST=1
+    // Wait until VI6_DISP0_IRQ_STA.DST=1
+    if (rzg2l_poll_set(VSPD_base_addr + 0x007C, 0x00000100, 500)) {
+        printf("fast-logo: VSPD display start timed out\n");
+        return -ETIMEDOUT;
+    }
 
 #if (DISPLAY_MODE != PARALLEL_RGB_720P)
     reg_write(DU_base_addr + 0x0000, 0x00000100);   // DU_MCR0 : DI_EN=1
-    while ((reg_read(DSI_LINK_base_addr + ISR) & 0x00000100) != 0x00000100);// ISR.VIN1
+    // ISR.VIN1
+    if (rzg2l_poll_set(DSI_LINK_base_addr + ISR, 0x00000100, 500)) {
+        printf("fast-logo: MIPI DSI video input timed out\n");
+        return -ETIMEDOUT;
+    }
 #endif
+
+    return 0;
 }
 
 /*
@@ -1250,7 +1302,7 @@ static void rzg2l_lcdc_start(void)
  * Wait for @frames output frames. @timeout_ms keeps a display that never
  * starts from hanging the boot.
  */
-static void rzg2l_wait_frames(unsigned int frames, unsigned int timeout_ms)
+static int rzg2l_wait_frames(unsigned int frames, unsigned int timeout_ms)
 {
 	unsigned long ts = get_timer(0);
 
@@ -1261,9 +1313,143 @@ static void rzg2l_wait_frames(unsigned int frames, unsigned int timeout_ms)
 			 VI6_DISP_IRQ_STA_DST)) {
 			if (get_timer(ts) >= timeout_ms) {
 				printf("fast-logo: display start timed out\n");
-				return;
+				return -ETIMEDOUT;
 			}
 			udelay(100);
 		}
 	}
+
+	return 0;
+}
+
+/*
+ * ------------------------------------------------------------------------
+ * Hand-over to the kernel
+ * ------------------------------------------------------------------------
+ * The kernel drivers take over the running display only if their device tree
+ * node has "renesas,seamless-boot-logo". Only this driver knows that the
+ * display runs, so it adds the property at boot. The board .dts stays stock.
+ * With another bootloader, or a display that failed to start, the kernel
+ * starts the display itself.
+ *
+ * The HDMI bridge also gets the CEA VIC of the current mode, which pins its
+ * connector to that mode. Its hot-plug interrupt is removed, because a
+ * hot-plug event would re-probe the bridge.
+ *
+ * Hook: ft_system_setup(), called by image_setup_libfdt() for the booted tree.
+ *   - Not EVT_FT_FIXUP: DM_DEV_READ_INLINE leaves OFNODE_MULTI_TREE off, so
+ *     the event is never raised for the kernel tree.
+ *   - Not ft_board_setup(): rcar-common defines it, and the BSP turns
+ *     OF_BOARD_SETUP off for RZ/G3L.
+ *
+ * "logo_handover=no" skips the declaration, to compare with a normal kernel
+ * start.
+ */
+#if !CONFIG_IS_ENABLED(OF_SYSTEM_SETUP)
+#error "the boot logo hand-over is declared from ft_system_setup(), which needs CONFIG_OF_SYSTEM_SETUP"
+#endif
+
+static const char * const rzg2l_logo_handover_nodes[] = {
+	"/soc/vsp@10870000",		/* VSPD */
+	"/soc/display@10890000",	/* DU */
+	"/soc/dsi@10850000",		/* MIPI DSI */
+	"/soc/i2c@10090800/hdmi@3d",	/* ADV7535 */
+};
+
+#define LOGO_HDMI_NODE		"/soc/i2c@10090800/hdmi@3d"
+#define LOGO_PROP_HANDOVER	"renesas,seamless-boot-logo"
+#define LOGO_PROP_VIC		"renesas,seamless-boot-logo-vic"
+
+/* Remove every property the fix-up adds, leaving the stock tree. */
+static void rzg2l_logo_ft_undo(void *blob)
+{
+	unsigned int i;
+	int off;
+
+	for (i = 0; i < ARRAY_SIZE(rzg2l_logo_handover_nodes); i++) {
+		off = fdt_path_offset(blob, rzg2l_logo_handover_nodes[i]);
+		if (off >= 0)
+			fdt_delprop(blob, off, LOGO_PROP_HANDOVER);
+	}
+
+	off = fdt_path_offset(blob, LOGO_HDMI_NODE);
+	if (off >= 0)
+		fdt_delprop(blob, off, LOGO_PROP_VIC);
+}
+
+static void rzg2l_logo_ft_fixup(void *blob)
+{
+	unsigned int i;
+	int off, ret = 0;
+
+	if (!rzg2l_logo_running) {
+		printf("fast-logo: display not running, hand-over not declared\n");
+		return;
+	}
+
+	if (rzg2l_logo_handover_off) {
+		printf("fast-logo: logo_handover=no, kernel brings the display up itself\n");
+		return;
+	}
+
+	/*
+	 * All or nothing. With a partial declaration, one driver would take
+	 * over the display and the next one would reset it.
+	 */
+	for (i = 0; i < ARRAY_SIZE(rzg2l_logo_handover_nodes); i++) {
+		if (fdt_path_offset(blob, rzg2l_logo_handover_nodes[i]) < 0) {
+			printf("fast-logo: no %s in the device tree, hand-over not declared\n",
+			       rzg2l_logo_handover_nodes[i]);
+			return;
+		}
+	}
+
+	off = fdt_path_offset(blob, LOGO_HDMI_NODE);
+	if (fdt_node_check_compatible(blob, off, "adi,adv7535")) {
+		printf("fast-logo: %s is not an ADV7535, hand-over not declared\n",
+		       LOGO_HDMI_NODE);
+		return;
+	}
+
+	/*
+	 * Editing the blob moves node offsets, so each node is looked up again
+	 * before it is written. On failure, undo all changes: a partial
+	 * declaration is worse than none.
+	 */
+	for (i = 0; i < ARRAY_SIZE(rzg2l_logo_handover_nodes) && !ret; i++) {
+		off = fdt_path_offset(blob, rzg2l_logo_handover_nodes[i]);
+		ret = fdt_setprop_empty(blob, off, LOGO_PROP_HANDOVER);
+	}
+
+	if (!ret) {
+		off = fdt_path_offset(blob, LOGO_HDMI_NODE);
+		ret = fdt_setprop_u32(blob, off, LOGO_PROP_VIC, LCD_CEA_VIC);
+	}
+
+	if (!ret) {
+		off = fdt_path_offset(blob, LOGO_HDMI_NODE);
+		ret = fdt_delprop(blob, off, "interrupts-extended");
+		if (ret == -FDT_ERR_NOTFOUND)
+			ret = 0;
+	}
+
+	if (ret) {
+		rzg2l_logo_ft_undo(blob);
+		printf("fast-logo: could not declare the hand-over (%s), kernel brings the display up itself\n",
+		       fdt_strerror(ret));
+		return;
+	}
+
+	printf("fast-logo: hand-over declared to the kernel, CEA VIC %u\n",
+	       LCD_CEA_VIC);
+}
+
+/*
+ * Always returns 0. A non-zero return aborts the boot, and a logo problem must
+ * not stop the boot.
+ */
+int ft_system_setup(void *blob, struct bd_info *bd)
+{
+	rzg2l_logo_ft_fixup(blob);
+	return 0;
 }
