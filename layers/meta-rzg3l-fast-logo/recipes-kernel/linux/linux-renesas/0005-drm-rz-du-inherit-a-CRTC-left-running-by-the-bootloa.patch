From 0ce225d6b467f38c0e7932f886c8707cd2bbb67d Mon Sep 17 00:00:00 2001
From: Zixuan Zhang <zixuan.zhang.uj@renesas.com>
Date: Wed, 5 Aug 2026 11:55:13 +0900
Subject: [PATCH] drm: rz-du: inherit a CRTC left running by the bootloader

With "renesas,seamless-boot-logo" on the DU node the LCDC is already
generating video when the driver probes, and the first modeset must not
disturb it.  Three places in the CRTC path would:

 - rzg2l_du_crtc_set_display_timing() calls clk_set_parent()/clk_set_rate()
   on the dot clock, which re-locks PLL7, and then rewrites DU_DITR0..4
   and DU_PBCR0, which restarts DU sync.  The values it computes are the
   ones already programmed - U-Boot uses the same CEA 1280x720@60 timings
   and the same clock formula - so the whole block is pure churn that
   costs several frames of HDMI re-sync.  Only the clk_prepare_enable() at
   the top is kept, because rzg2l_du_crtc_put() has a matching
   clk_disable_unprepare().

 - rzg2l_du_crtc_start() writes DU_MCR0.DI_EN, which is already set.
   Writing it again restarts the display interface.

 - rzg2l_du_crtc_atomic_flush() runs before the modeset enable, because
   drm_atomic_helper_commit_tail_rpm() commits planes first.  On the first
   commit the VSP pipeline has not been set up yet, so the flush builds a
   display list from an empty pipeline and hw-enqueues it into
   VI6_DL_HDR_ADDR0 - the register that still points at the bootloader's
   self-looping chain.

Skip all three while the hand-over is pending.  rzg2l_du_crtc_get() and
rzg2l_du_vsp_enable() still run in full, so the kernel really does take
the VSP over on this commit; because everything downstream of the VSP is
left alone, the new configuration is latched at a frame boundary and the
sink sees a content change rather than a mode change.

The flag is cleared by the first atomic enable or the first atomic
disable, so runtime modeset, DPMS and suspend/resume behave exactly as
they do without the boot logo.
---
 drivers/gpu/drm/renesas/rz-du/rzg2l_du_crtc.c | 42 +++++++++++++++++++
 drivers/gpu/drm/renesas/rz-du/rzg2l_du_crtc.h |  7 ++++
 2 files changed, 49 insertions(+)

diff --git a/drivers/gpu/drm/renesas/rz-du/rzg2l_du_crtc.c b/drivers/gpu/drm/renesas/rz-du/rzg2l_du_crtc.c
index 456edf69c541..c10b0995059f 100644
--- a/drivers/gpu/drm/renesas/rz-du/rzg2l_du_crtc.c
+++ b/drivers/gpu/drm/renesas/rz-du/rzg2l_du_crtc.c
@@ -9,6 +9,7 @@
 
 #include <linux/clk.h>
 #include <linux/mutex.h>
+#include <linux/of.h>
 #include <linux/platform_device.h>
 #include <linux/clk-provider.h>
 #include <linux/reset.h>
@@ -73,6 +74,17 @@ static void rzg2l_du_crtc_set_display_timing(struct rzg2l_du_crtc *rcrtc)
 
 	clk_prepare_enable(rcrtc->rzg2l_clocks.dclk);
 
+	/*
+	 * Everything below reprograms hardware that is already generating the
+	 * bootloader's picture with exactly these numbers: clk_set_rate() would
+	 * re-lock PLL7, and rewriting DU_DITR0..4 restarts DU sync.  Both drop
+	 * HDMI sync for several frames.  Keep only the clk_prepare_enable()
+	 * above, which the matching clk_disable_unprepare() in
+	 * rzg2l_du_crtc_put() needs.
+	 */
+	if (rcrtc->boot_logo_handover)
+		return;
+
 	if (of_device_is_compatible(rcrtc->dev->dev->of_node, "renesas,r9a08g046-du")) {
 		struct clk *clk_parent;
 		struct clk_hw *hw_parent, *hw_pparent;
@@ -298,6 +310,18 @@ static void rzg2l_du_crtc_atomic_enable(struct drm_crtc *crtc,
 
 	rzg2l_du_crtc_get(rcrtc);
 
+	/*
+	 * rzg2l_du_crtc_get() has just handed the VSP over to the kernel
+	 * through rzg2l_du_vsp_enable(); the DU itself is untouched and still
+	 * has DU_MCR0.DI_EN set from the bootloader.  Writing DI_EN again
+	 * restarts the display interface and makes the sink re-sync, so leave
+	 * the register alone and simply stop claiming the hand-over.
+	 */
+	if (rcrtc->boot_logo_handover) {
+		rcrtc->boot_logo_handover = false;
+		return;
+	}
+
 	rzg2l_du_crtc_start(rcrtc);
 }
 
@@ -306,6 +330,9 @@ static void rzg2l_du_crtc_atomic_disable(struct drm_crtc *crtc,
 {
 	struct rzg2l_du_crtc *rcrtc = to_rzg2l_crtc(crtc);
 
+	/* Nothing left to preserve once the CRTC is being taken down. */
+	rcrtc->boot_logo_handover = false;
+
 	rzg2l_du_crtc_stop(rcrtc);
 	rzg2l_du_crtc_put(rcrtc);
 
@@ -335,6 +362,17 @@ static void rzg2l_du_crtc_atomic_flush(struct drm_crtc *crtc,
 		spin_unlock_irqrestore(&dev->event_lock, flags);
 	}
 
+	/*
+	 * drm_atomic_helper_commit_tail_rpm() commits planes before it enables
+	 * the modeset, so on the very first commit this runs before
+	 * rzg2l_du_vsp_enable() has set the pipeline up.  Flushing here would
+	 * commit a display list built from an empty pipeline and, through
+	 * vsp1_dl_list_hw_enqueue(), overwrite VI6_DL_HDR_ADDR0 - which is the
+	 * register still pointing at the bootloader's self-looping chain.
+	 */
+	if (rcrtc->boot_logo_handover)
+		return;
+
 	rzg2l_du_vsp_atomic_flush(rcrtc);
 }
 
@@ -448,6 +486,10 @@ int rzg2l_du_crtc_create(struct rzg2l_du_device *rcdu)
 		return PTR_ERR(rcrtc->rzg2l_clocks.dclk);
 	}
 
+	rcrtc->boot_logo_handover =
+		of_property_read_bool(rcdu->dev->of_node,
+				      "renesas,seamless-boot-logo");
+
 	init_waitqueue_head(&rcrtc->flip_wait);
 	rcrtc->dev = rcdu;
 
diff --git a/drivers/gpu/drm/renesas/rz-du/rzg2l_du_crtc.h b/drivers/gpu/drm/renesas/rz-du/rzg2l_du_crtc.h
index cbba38acc377..d079017a1339 100644
--- a/drivers/gpu/drm/renesas/rz-du/rzg2l_du_crtc.h
+++ b/drivers/gpu/drm/renesas/rz-du/rzg2l_du_crtc.h
@@ -44,6 +44,13 @@ struct rzg2l_du_crtc {
 	struct rzg2l_du_device *dev;
 	bool initialized;
 
+	/*
+	 * Set from the "renesas,seamless-boot-logo" DT property: the
+	 * bootloader left the CRTC configured and scanning out.  Consumed by
+	 * the first atomic enable or disable, whichever comes first.
+	 */
+	bool boot_logo_handover;
+
 	bool vblank_enable;
 	struct drm_pending_vblank_event *event;
 	wait_queue_head_t flip_wait;
