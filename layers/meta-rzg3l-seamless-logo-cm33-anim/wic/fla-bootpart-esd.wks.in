# Short-description: SD card image for eSD boot with the CM33 firmware
# Long-description: rz-image-bootpart-esd.wks (meta-rz-bsp) plus the CM33
#                   firmware at sector 4992 (0x270000), where BL2 reads it
#                   (RZG3L_SD_M33_FW_BASE).

part --source rawcopy --sourceparams="file=bl2_bp_esd-${MACHINE}.bin" --no-table
part --source rawcopy --sourceparams="file=fip-${MACHINE}.bin" --no-table ${FIP_WIC_OFFSET} --align 64
part --source rawcopy --sourceparams="file=${RZG3L_CM33_FW}-${MACHINE}.bin" --no-table --offset 4992s

part --source bootimg-partition --fstype=vfat --label bootloader --align 1024
part --source rootfs            --fstype=ext4 --label root       --align 4
