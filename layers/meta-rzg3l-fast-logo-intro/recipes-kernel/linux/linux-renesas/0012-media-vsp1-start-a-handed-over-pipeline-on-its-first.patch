From 16de3f2fe899c8d47f19e8d3b7506f67c0dafe47 Mon Sep 17 00:00:00 2001
From: Zixuan Zhang <zixuan.zhang.uj@renesas.com>
Date: Wed, 30 Sep 2026 15:02:56 +0900
Subject: [PATCH] media: vsp1: start a handed-over pipeline on its first
 display list with planes

Taking the display over from the bootloader shows one frame of black on
RZ/G3L before the first picture.  The DU uses
drm_atomic_helper_commit_tail_rpm(), which enables the CRTC before it
updates planes.  So on the first commit rzg2l_du_vsp_enable() reaches
vsp1_du_setup_lif() while no RPF has joined the pipeline yet;
vsp1_du_pipeline_configure() commits a display list with only the BRx in
it, and vsp1_pipeline_run() starts on it.  The BRx outputs its
background colour, black, for the frame that list is active.  The list
carrying the planes, committed moments later by vsp1_du_atomic_flush(),
finds the first one queued but not yet taken by the hardware, so it is
held back until the next frame end: one black frame at least, visible
as a flash between the logo and the first picture.

rcar-du does not show this because its commit tail updates planes
before it enables the CRTC; by the time it calls vsp1_du_setup_lif()
the inputs are there.

While the boot logo hand-over is pending, have vsp1_du_setup_lif() set
the pipeline up but neither commit a display list nor start it; the
bootloader's list keeps running.  The first vsp1_du_atomic_flush() then
commits the first display list - planes included - and starts the
pipeline, and the hand-over is finished there instead.  The register
sequence is the one vsp1_du_setup_lif() used, list first and STRCMD
after, only with the inputs in place; the WPF frame end interrupt is
enabled through the same list, so vblank events are unaffected.

Disabling the CRTC before any flush clears the pending start, and the
existing hand-over release on the disable path still applies.  Without
the hand-over nothing changes.

Upstream-Status: Inappropriate [RZ/G3L boot logo, board specific]

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 .../media/platform/renesas/vsp1/vsp1_drm.c    | 44 +++++++++++++++++++
 .../media/platform/renesas/vsp1/vsp1_drm.h    |  8 ++++
 2 files changed, 52 insertions(+)

diff --git a/drivers/media/platform/renesas/vsp1/vsp1_drm.c b/drivers/media/platform/renesas/vsp1/vsp1_drm.c
index f7b5527..b95f62c 100644
--- a/drivers/media/platform/renesas/vsp1/vsp1_drm.c
+++ b/drivers/media/platform/renesas/vsp1/vsp1_drm.c
@@ -700,6 +700,7 @@ int vsp1_du_setup_lif(struct device *dev, unsigned int pipe_index,
 		}
 
 		drm_pipe->du_complete = NULL;
+		drm_pipe->boot_logo_start_pending = false;
 		pipe->num_inputs = 0;
 
 		dev_dbg(vsp1->dev, "%s: pipe %u: releasing %s\n",
@@ -768,6 +769,25 @@ int vsp1_du_setup_lif(struct device *dev, unsigned int pipe_index,
 	vsp1_write(vsp1, VI6_DISP_IRQ_STA(pipe_index), 0);
 	vsp1_write(vsp1, VI6_DISP_IRQ_ENB(pipe_index), 0);
 
+	/*
+	 * While the boot logo hand-over is pending the VSP is still walking
+	 * the bootloader's display list, and this commit's planes have not
+	 * been set up yet: drm_atomic_helper_commit_tail_rpm() enables the
+	 * CRTC before it updates planes.  A display list built now would have
+	 * no inputs, and the BRx would put its background colour on screen for
+	 * at least a frame - a black flash between the logo and the first
+	 * picture.  Leave the bootloader's list running instead, and let the
+	 * first vsp1_du_atomic_flush() commit the first display list, planes
+	 * included, and start the pipeline.
+	 */
+	if (vsp1->boot_logo_handover) {
+		drm_pipe->boot_logo_start_pending = true;
+		mutex_unlock(&vsp1->drm->lock);
+		dev_dbg(vsp1->dev, "%s: pipeline start deferred to the first flush\n",
+			__func__);
+		return 0;
+	}
+
 	/* Configure all entities in the pipeline. */
 	vsp1_du_pipeline_configure(pipe);
 
@@ -910,6 +930,7 @@ void vsp1_du_atomic_flush(struct device *dev, unsigned int pipe_index,
 	struct vsp1_device *vsp1 = dev_get_drvdata(dev);
 	struct vsp1_drm_pipeline *drm_pipe = &vsp1->drm->pipe[pipe_index];
 	struct vsp1_pipeline *pipe = &drm_pipe->pipe;
+	bool started = false;
 	int ret;
 
 	drm_pipe->crc = cfg->crc;
@@ -937,8 +958,31 @@ void vsp1_du_atomic_flush(struct device *dev, unsigned int pipe_index,
 
 	vsp1_du_pipeline_configure(pipe);
 
+	/*
+	 * The first flush after vsp1_du_setup_lif() deferred the start: the
+	 * display list just committed is the kernel's first, and it carries
+	 * this commit's planes.  Start the pipeline on it.  The hardware
+	 * latches the list at the next frame boundary, so the bootloader's
+	 * picture is replaced by the first picture with no frame in between.
+	 */
+	if (drm_pipe->boot_logo_start_pending) {
+		unsigned long flags;
+
+		drm_pipe->boot_logo_start_pending = false;
+
+		spin_lock_irqsave(&pipe->irqlock, flags);
+		vsp1_pipeline_run(pipe);
+		spin_unlock_irqrestore(&pipe->irqlock, flags);
+
+		started = true;
+	}
+
 done:
 	mutex_unlock(&vsp1->drm->lock);
+
+	/* The kernel owns the VSP now; give it back to runtime PM. */
+	if (started)
+		vsp1_finish_boot_logo_handover(vsp1);
 }
 EXPORT_SYMBOL_GPL(vsp1_du_atomic_flush);
 
diff --git a/drivers/media/platform/renesas/vsp1/vsp1_drm.h b/drivers/media/platform/renesas/vsp1/vsp1_drm.h
index 3fd95b5..fb2ed29 100644
--- a/drivers/media/platform/renesas/vsp1/vsp1_drm.h
+++ b/drivers/media/platform/renesas/vsp1/vsp1_drm.h
@@ -46,6 +46,14 @@ struct vsp1_drm_pipeline {
 	/* Frame synchronisation */
 	void (*du_complete)(void *data, unsigned int status, u32 crc);
 	void *du_private;
+
+	/*
+	 * Set by vsp1_du_setup_lif() while a boot logo hand-over is pending:
+	 * the pipeline is set up but not started, and the bootloader's display
+	 * list is still on screen.  The first vsp1_du_atomic_flush() commits
+	 * the first display list and starts the pipeline.
+	 */
+	bool boot_logo_start_pending;
 };
 
 /**
