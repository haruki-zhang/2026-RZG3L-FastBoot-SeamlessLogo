From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Zixuan Zhang <zixuan.zhang.uj@renesas.com>
Date: Tue, 9 Sep 2026 15:00:00 +0900
Subject: [PATCH 7/7] video: rzg2l: find the intro on whichever medium the
 board booted from

The driver loads its frames with a hard-coded "ext4load mmc 0:2", inherited
from the patch that first moved the splash onto the rootfs partition.  That
device number is only right when the board boots from eMMC.  Booted from
microSD the same image gets:

  fast-logo: 4 frame intro, 400 ms per frame
  Failed to load 'boot/boot_img_1080p_00.bin.gz'
  fast-logo: no splash image, showing a blank screen

and the screen stays black until a Linux application takes over - on a
measured boot, from 1.04 s to 13.22 s.  Note the wording: "Failed to load",
not "Can't set block device".  The eMMC partition mounted fine, it just holds
a different image; the frames were on the SD card all along.

The BSP does not compile the medium in either.  bootcmd_check is

  if mmc dev 1; then run sd1load; else run emmcload; fi

- a card in slot 1 wins, eMMC is the fallback - so mirror that.  The
"logo_mmc_dev" environment variable overrides the detection for layouts that
do not follow the rule, in the same way "logo_frames" and "logo_rate_ms"
override the intro's shape.

Deliberately not mmc_get_env_dev().  It looks like the obvious source of
truth and it is wrong here: on this board U-Boot reads its environment from
the eMMC ("Loading Environment from MMC... Reading from MMC(0)") while the
rootfs is on the SD card, so it would reproduce the bug it is meant to fix.

Auto-detection answers "which medium is this board booting from", which is
not quite "which medium has the frames on it" - a board carrying a stale
image on the medium it is not booting from will mount that one and find
nothing.  So frame 0 gets one retry on the other device before the blank
screen fallback.  The device is settled once and reused for the rest of the
intro rather than probed per frame.

Upstream-Status: Inappropriate [RZ/G3L boot animation, board specific]
---
 drivers/video/rzg2l/rzg2l_video.c | 87 ++++++++++++++++++++++++++-----
 1 file changed, 74 insertions(+), 13 deletions(-)

--- a/drivers/video/rzg2l/rzg2l_video.c
+++ b/drivers/video/rzg2l/rzg2l_video.c
@@ -111,6 +111,9 @@
 #define LOGO_RATE_MS_MIN	(1000 / LOGO_REFRESH_HZ)
 #define LOGO_RATE_MS_MAX	10000
 
+/* "logo_mmc_dev" unset: work the boot medium out at run time. */
+#define LOGO_MMC_DEV_AUTO	(~0UL)
+
 static void rzg2l_cpg_init(void);
 static void adv7535_init(void);
 static void adv7535_deinit(void);
@@ -123,7 +126,8 @@
 static void rzg2l_lcdc_start(void);
 static void rzg2l_wait_frames(unsigned int frames, unsigned int timeout_ms);
 static void rzg2l_logo_read_config(unsigned int *frames, unsigned int *repeats);
-static int rzg2l_logo_load_frame(unsigned int index);
+static unsigned int rzg2l_logo_mmc_dev(void);
+static int rzg2l_logo_load_frame(unsigned int dev, unsigned int index);
 static void rzg2l_logo_build_chain(unsigned int frames, unsigned int repeats);
 
 static void rzg2ul_adv7513_init(void);
@@ -131,7 +135,8 @@
 static int adv7513_i2c_reg_read(struct udevice *dev, uint8_t addr, uint8_t *data);
 
 int rzg2l_video_init(void){
-	unsigned int frames, repeats, i;
+	unsigned int frames, repeats, i, dev;
+	int ret;
 
 	// adv7535_deinit();
 	rzg2l_cpg_init();
@@ -177,7 +182,25 @@
 	 * file U-Boot reads.  Partition 1 is the vfat "bootloader" partition of
 	 * the BSP image layout and ext4load cannot mount it.
 	 */
-	if (rzg2l_logo_load_frame(0)) {
+	dev = rzg2l_logo_mmc_dev();
+
+	ret = rzg2l_logo_load_frame(dev, 0);
+	if (ret) {
+		/*
+		 * The detection answers "which medium is this board booting
+		 * from", which is not quite "which medium has the frames on
+		 * it" - a board with a stale image on the medium it is not
+		 * booting from will mount that one and find nothing.  One
+		 * retry on the other device costs a few milliseconds and
+		 * covers it.
+		 */
+		printf("fast-logo: no intro on mmc %u:2, trying mmc %u:2\n",
+		       dev, dev ^ 1u);
+		dev ^= 1u;
+		ret = rzg2l_logo_load_frame(dev, 0);
+	}
+
+	if (ret) {
 		/*
 		 * Start the pipeline anyway, on a blanked frame buffer.  The
 		 * device tree tells the kernel that the bootloader handed it a
@@ -190,6 +213,8 @@
 		memset((void *)(unsigned long)LCD_SRCM_ADDR, 0,
 		       LCD_SRCM_ADDR_OFFS);
 		frames = 1;
+	} else {
+		printf("fast-logo: intro from mmc %u:2\n", dev);
 	}
 
 	dcache_disable();
@@ -224,7 +249,7 @@
 	 * a much better failure than a dead one.
 	 */
 	for (i = 1; i < frames; i++) {
-		if (rzg2l_logo_load_frame(i)) {
+		if (rzg2l_logo_load_frame(dev, i)) {
 			printf("fast-logo: frame %u did not load, intro cut to %u frame(s)\n",
 			       i, i);
 			frames = i;
@@ -278,15 +303,45 @@
 	printf("fast-logo: %u frame intro, %lu ms per frame\n", *frames, rate);
 }
 
+/*
+ * Which MMC device the intro frames are on.
+ *
+ * The same image boots from eMMC or from microSD, and the BSP decides which at
+ * run time - bootcmd_check is
+ *
+ *   if mmc dev 1; then run sd1load; else run emmcload; fi
+ *
+ * so a card in slot 1 wins and the eMMC is the fallback.  Mirror that instead
+ * of compiling a device number in: a fixed one is silently right on one medium
+ * and silently wrong on the other, and the failure is a blank screen with a
+ * single line on the console.
+ *
+ * Deliberately not derived from mmc_get_env_dev(): on this board the
+ * environment is read from the eMMC even when the rootfs is on the SD card, so
+ * "where the environment came from" answers a different question.
+ *
+ * Decided once, for the whole intro - probing per frame would repeat the
+ * device switch and its console banner N times.
+ */
+static unsigned int rzg2l_logo_mmc_dev(void)
+{
+	unsigned long dev = env_get_ulong("logo_mmc_dev", 10, LOGO_MMC_DEV_AUTO);
+
+	if (dev != LOGO_MMC_DEV_AUTO)
+		return (unsigned int)dev;
+
+	return run_command("mmc dev 1", 0) == 0 ? 1u : 0u;
+}
+
 /* Load one gzip-compressed XRGB8888 frame into its slot in the reserved area. */
-static int rzg2l_logo_load_frame(unsigned int index)
+static int rzg2l_logo_load_frame(unsigned int dev, unsigned int index)
 {
 	char cmd[128];
 	int ret;
 
 	snprintf(cmd, sizeof(cmd),
-		 "ext4load mmc 0:2 0x%08x boot/" LOGO_FILE_PREFIX "_%02u.bin.gz",
-		 LOGO_LOAD_ADDR, index);
+		 "ext4load mmc %u:2 0x%08x boot/" LOGO_FILE_PREFIX "_%02u.bin.gz",
+		 dev, LOGO_LOAD_ADDR, index);
 	ret = run_command(cmd, 0);
 	if (ret)
 		return ret;
