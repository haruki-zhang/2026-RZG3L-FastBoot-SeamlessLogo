From a373416c5d5b917eb0ef42705cfca24d147bb1fa Mon Sep 17 00:00:00 2001
From: Zixuan Zhang <zixuan.zhang.uj@renesas.com>
Date: Tue, 29 Sep 2026 18:08:47 +0900
Subject: [PATCH 08/10] video: rzg2l: pick the display timing from the logo
 resolution

The display mode was a hard-coded DISPLAY_MODE, and the resolution it
implied was restated in three more places: which define_*.h was
included, the name of the frame files, and - outside U-Boot - the CEA
VIC the kernel pins its HDMI connector to.  Changing resolution meant
editing all of them by hand and keeping them in step.

Make RZG2L_LOGO_WIDTH and RZG2L_LOGO_HEIGHT the one input.  They select
the timing table, and a build for a size that has no table stops at an
#error naming what to add.  The table must describe the size it is
selected for, and now also carries LCD_CEA_VIC, so that everything a
resolution implies lives in one header:

  define_1080p.h   1920x1080@60   CEA VIC 16
  define_720p.h    1280x720@60    CEA VIC 4

Adding a resolution is a new define_*.h plus one #elif.  The Yocto layer
passes both macros through KCFLAGS; built on its own, the driver keeps
building for 1080p.

DISPLAY_MODE stays, now always MIPI_DSI: the remaining tests only ask
whether the output is parallel RGB or not, and folding the resolution
into that value is what made it impossible to add one.

The frame files are renamed boot/fastlogo_<W>x<H>_NN.bin.gz.  With the
geometry in the name, a bootloader and a rootfs built for different
resolutions find nothing instead of scanning out each other's frames at
the wrong stride.

Loading gets two checks it lacked.  unzip is bounded by one frame slot,
because a frame drawn for a larger resolution would otherwise inflate
into the next slot or into the display lists the VSPD is fetching.  And
the inflated size must be exactly one frame, because a short file would
leave the rest of its slot stale.

LOGO_REFRESH_HZ comes from the table's refresh value instead of a
literal 60.

Upstream-Status: Inappropriate [RZ/G3L boot logo, board specific]

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 drivers/video/rzg2l/define_1080p.h |  3 +
 drivers/video/rzg2l/define_720p.h  |  3 +
 drivers/video/rzg2l/rzg2l_video.c  | 88 ++++++++++++++++++++++--------
 3 files changed, 72 insertions(+), 22 deletions(-)

diff --git a/drivers/video/rzg2l/define_1080p.h b/drivers/video/rzg2l/define_1080p.h
index 50820e6dd2..87dba9fcda 100644
--- a/drivers/video/rzg2l/define_1080p.h
+++ b/drivers/video/rzg2l/define_1080p.h
@@ -2,6 +2,9 @@
 #define __DSI_DEFINE__
 
 // 1080p 148.5MHz
+/* CEA-861 VIC of this timing. The kernel pins its HDMI connector to it. */
+#define LCD_CEA_VIC		16
+
 #define	CPG_PLL7_CLK1_VAL	0x00527000
 #define	CPG_PLL7_CLK2_VAL	0x00000003
 
diff --git a/drivers/video/rzg2l/define_720p.h b/drivers/video/rzg2l/define_720p.h
index 86fdbf743e..f8aa248cf5 100644
--- a/drivers/video/rzg2l/define_720p.h
+++ b/drivers/video/rzg2l/define_720p.h
@@ -2,6 +2,9 @@
 #define __DSI_DEFINE__
 
 // 720P 74.25MHz
+/* CEA-861 VIC of this timing. The kernel pins its HDMI connector to it. */
+#define LCD_CEA_VIC		4
+
 #define	CPG_PLL7_CLK1_VAL	0x04527000
 #define	CPG_PLL7_CLK2_VAL	0x00000003
 
diff --git a/drivers/video/rzg2l/rzg2l_video.c b/drivers/video/rzg2l/rzg2l_video.c
index 3ebb55c317..c5c57e82bf 100644
--- a/drivers/video/rzg2l/rzg2l_video.c
+++ b/drivers/video/rzg2l/rzg2l_video.c
@@ -32,21 +32,46 @@
 #define MIPI_DSI_720P		1
 #define	LVDS_720P		2
 #define PARALLEL_RGB_720P	3
+/* MIPI DSI -> ADV7535 -> HDMI, at the resolution of the timing table below. */
+#define MIPI_DSI		4
 
 /*
- * 1080p, to match the 1920x1080 boot animation this layer ships and the
- * CEA VIC 16 the kernel pins the connector to.  These three have to agree:
- * U-Boot programs the hardware from define_1080p.h, the kernel advertises
- * exactly one mode and refuses everything else, and the player selects the
- * mode that matches its artwork.  Changing one without the other two gets
- * you a connector pinned to a mode the hardware is not scanning out.
+ * Output resolution, and with it the whole display timing.
+ *
+ * The driver does not read EDID, so every mode it can drive is a table of
+ * precomputed timings - PLL7, D-PHY, DSI link, DU and ADV7535 - in a
+ * define_*.h header.  RZG2L_LOGO_WIDTH and RZG2L_LOGO_HEIGHT pick the table.
+ * The Yocto layer passes both on the compiler command line (KCFLAGS), derived
+ * from RZG3L_FASTLOGO_RESOLUTION; without them the driver builds for 1080p.
+ *
+ * To add a resolution:
+ *   1. copy define_1080p.h to a new header and fill in the timings, including
+ *      LCD_CEA_VIC - the kernel pins its HDMI connector to that CEA mode;
+ *   2. add an #elif for it below.
+ * The ADV7535 tops out at a 148.5 MHz pixel clock, i.e. 1920x1080@60.
  */
-#define	DISPLAY_MODE MIPI_DSI_1080P
+#ifndef RZG2L_LOGO_WIDTH
+#define RZG2L_LOGO_WIDTH	1920
+#endif
+#ifndef RZG2L_LOGO_HEIGHT
+#define RZG2L_LOGO_HEIGHT	1080
+#endif
+
+#define	DISPLAY_MODE		MIPI_DSI
 
-#if (DISPLAY_MODE == MIPI_DSI_1080P)
+#if (RZG2L_LOGO_WIDTH == 1920) && (RZG2L_LOGO_HEIGHT == 1080)
 #include "define_1080p.h"
-#else
+#elif (RZG2L_LOGO_WIDTH == 1280) && (RZG2L_LOGO_HEIGHT == 720)
 #include "define_720p.h"
+#else
+#error "no display timing for RZG2L_LOGO_WIDTH x RZG2L_LOGO_HEIGHT - add a define_*.h, see above"
+#endif
+
+#if (LCD_HACTIVE != RZG2L_LOGO_WIDTH) || (LCD_VACTIVE != RZG2L_LOGO_HEIGHT)
+#error "the selected timing table does not describe RZG2L_LOGO_WIDTH x RZG2L_LOGO_HEIGHT"
+#endif
+#ifndef LCD_CEA_VIC
+#error "the selected timing table does not name its CEA VIC (LCD_CEA_VIC)"
 #endif
 
 /* Frame buffer offset */
@@ -78,14 +103,16 @@
  */
 #define LOGO_LOAD_ADDR		0x48000000
 
-#if (DISPLAY_MODE == MIPI_DSI_1080P)
-#define LOGO_FILE_PREFIX	"boot_img_1080p"
-#else
-#define LOGO_FILE_PREFIX	"boot_img_720p"
-#endif
+/*
+ * Frame NN of the intro is boot/fastlogo_<W>x<H>_NN.bin.gz on the rootfs
+ * partition.  The geometry is part of the name, so that a bootloader and a
+ * rootfs built for different resolutions find nothing rather than scanning
+ * out each other's frames with the wrong stride.
+ */
+#define LOGO_FILE_FMT		"boot/fastlogo_%ux%u_%02u.bin.gz"
 
-/* Output frame rate. CEA VIC 16 and VIC 4 are both exactly 60 Hz. */
-#define LOGO_REFRESH_HZ		60
+/* Output frame rate, from the timing table. */
+#define LOGO_REFRESH_HZ		(refresh)
 
 /*
  * Compiled-in defaults. Both are overridden at run time by the "logo_frames"
@@ -339,17 +366,34 @@ static int rzg2l_logo_load_frame(unsigned int dev, unsigned int index)
 	char cmd[128];
 	int ret;
 
-	snprintf(cmd, sizeof(cmd),
-		 "ext4load mmc %u:2 0x%08x boot/" LOGO_FILE_PREFIX "_%02u.bin.gz",
-		 dev, LOGO_LOAD_ADDR, index);
+	snprintf(cmd, sizeof(cmd), "ext4load mmc %u:2 0x%08x " LOGO_FILE_FMT,
+		 dev, LOGO_LOAD_ADDR, LCD_HACTIVE, LCD_VACTIVE, index);
 	ret = run_command(cmd, 0);
 	if (ret)
 		return ret;
 
-	snprintf(cmd, sizeof(cmd), "unzip 0x%08x 0x%08lx", LOGO_LOAD_ADDR,
+	/*
+	 * Bound the inflate by one frame slot.  Unbounded, a frame drawn for a
+	 * larger resolution would run on into the next slot or, for the last
+	 * frames, into the display lists the VSPD is fetching.
+	 */
+	snprintf(cmd, sizeof(cmd), "unzip 0x%08x 0x%08lx 0x%x", LOGO_LOAD_ADDR,
 		 (unsigned long)LCD_SRCM_ADDR +
-		 (unsigned long)LCD_SRCM_ADDR_OFFS * index);
-	return run_command(cmd, 0);
+		 (unsigned long)LCD_SRCM_ADDR_OFFS * index,
+		 LCD_SRCM_ADDR_OFFS);
+	ret = run_command(cmd, 0);
+	if (ret)
+		return ret;
+
+	/* A short frame would leave the rest of its slot stale. */
+	if (env_get_hex("filesize", 0) != LCD_SRCM_ADDR_OFFS) {
+		printf("fast-logo: frame %u is 0x%lx bytes, expected 0x%x (%ux%u XRGB8888)\n",
+		       index, env_get_hex("filesize", 0), LCD_SRCM_ADDR_OFFS,
+		       LCD_HACTIVE, LCD_VACTIVE);
+		return 1;
+	}
+
+	return 0;
 }
 
 static const uint32_t cpg_register_values[][2] = {//0x11010000  //step1
