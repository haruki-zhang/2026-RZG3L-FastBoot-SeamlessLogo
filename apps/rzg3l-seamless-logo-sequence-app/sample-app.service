# DefaultDependencies=no, WantedBy=sysinit.target: start as early as possible.
#   Wants= does not order, so sysinit.target does not wait for the images.
# Type=notify, Before=weston.service: only one program can be DRM master.
#   Weston starts when the program reports readiness, after it has dropped
#   master.
# TimeoutStartSec: a hung program holds Weston back for at most 60 s.

[Unit]
Description=Boot logo sample application
DefaultDependencies=no
After=local-fs.target
Before=weston.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/home/root/run-app.sh
TimeoutStartSec=60
TimeoutStopSec=5

[Install]
WantedBy=sysinit.target
